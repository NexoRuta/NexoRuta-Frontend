@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthenticationStateProvider
@inject NexoRuta.Commerce.Core.Security.CommerceAuthorizationState AuthorizationState

<nav class="nr-navigation" aria-label="Navegación principal" aria-busy="@(cargando ? "true" : "false")">
    @if (cargando && gruposVisibles.Count == 0)
    {
        <div class="nr-nav-group" aria-hidden="true">
            <p class="nr-nav-heading"><span class="placeholder col-5"></span></p>
            <ul class="nr-nav-list">
                <li><span class="nr-nav-link placeholder col-9"></span></li>
                <li><span class="nr-nav-link placeholder col-7"></span></li>
            </ul>
        </div>
        <span class="visually-hidden" role="status">Cargando navegación y permisos.</span>
    }
    else
    {
        @foreach (var group in gruposVisibles)
        {
            <div class="nr-nav-group">
                <p class="nr-nav-heading">@group.Label</p>
                <ul class="nr-nav-list">
                    @foreach (var link in group.Links)
                    {
                        <li><NavLink class="nr-nav-link" href="@link.Href" Match="NavLinkMatch.All">@link.Label</NavLink></li>
                    }
                </ul>
            </div>
        }
        @if (cargando)
        {
            <span class="visually-hidden" role="status">Actualizando permisos de navegación.</span>
        }
        @if (AuthorizationState.Failure is NexoRuta.Commerce.Core.Security.CommerceAuthorizationFailure.ApiUnavailable or NexoRuta.Commerce.Core.Security.CommerceAuthorizationFailure.SessionExpired)
        {
            <CommerceAuthorizationMessage />
        }
    }
</nav>

@code {
    private IReadOnlyList<CommerceNavigationGroup> gruposVisibles = [];
    private bool cargando = true;

    protected override Task OnInitializedAsync() => ActualizarNavegacionAsync();

    private async Task ActualizarNavegacionAsync()
    {
        cargando = true;
        AuthorizationState.Clear();

        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            var grupos = new List<CommerceNavigationGroup>();
            foreach (var group in CommerceNavigationCatalog.Groups)
            {
                var links = new List<CommerceNavigationLink>();
                foreach (var link in group.Links)
                {
                    if (link.PermissionPolicy is null ||
                        (await Authorization.AuthorizeAsync(user, resource: null, link.PermissionPolicy)).Succeeded)
                        links.Add(link);

                    if (AuthorizationState.Failure is NexoRuta.Commerce.Core.Security.CommerceAuthorizationFailure.ApiUnavailable or NexoRuta.Commerce.Core.Security.CommerceAuthorizationFailure.SessionExpired)
                        break;
                }

                if (links.Count > 0) grupos.Add(group with { Links = links });
                if (AuthorizationState.Failure is NexoRuta.Commerce.Core.Security.CommerceAuthorizationFailure.ApiUnavailable or NexoRuta.Commerce.Core.Security.CommerceAuthorizationFailure.SessionExpired)
                    break;
            }

            gruposVisibles = grupos;
        }
        catch (HttpRequestException)
        {
            AuthorizationState.SetFailure(NexoRuta.Commerce.Core.Security.CommerceAuthorizationFailure.ApiUnavailable);
            gruposVisibles = [];
        }
        finally
        {
            cargando = false;
        }
    }
}
