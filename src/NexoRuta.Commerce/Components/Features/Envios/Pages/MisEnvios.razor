@page "/envios"
@rendermode InteractiveServer
@using System.Net
@using Microsoft.AspNetCore.Components.Authorization
@using NexoRuta.ApiClient.Core.Session
@using NexoRuta.ApiClient.Core.Exceptions
@using NexoRuta.ApiClient.Features.Envios.Clients
@using NexoRuta.ApiClient.Features.Envios.Contracts.Responses
@using NexoRuta.ApiClient.Features.Usuarios.Clients
@inject EnviosApiClient ApiClient
@inject UsuariosApiClient UsuariosClient
@inject AuthenticationStateProvider AuthenticationState
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@implements IDisposable

<PageTitle>Mis envíos | NexoRuta</PageTitle>
<h1>Mis envíos</h1>
<p><a href="/envios/crear">Crear envío</a></p>
<button class="btn btn-outline-secondary mb-2" disabled="@(cargando || consultando is not null)" @onclick="CargarAsync">Actualizar lista</button>
@if (mensaje is not null)
{
    <p class="alert alert-warning" role="alert">@mensaje</p>
}
@if (cargando)
{
    <p role="status">Cargando envíos…</p>
}
else if (envios.Count == 0 && mensaje is null)
{
    <p role="status">Todavía no tenés envíos.</p>
}
else if (envios.Count > 0)
{
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th scope="col">Envío</th><th scope="col">Operador</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead>
            <tbody>
                @foreach (var envio in envios)
                {
                    <tr @key="envio.Id">
                        <td>@envio.Id</td><td>@envio.OperadorNombre</td><td>@envio.Estado</td>
                        <td><button class="btn btn-primary" disabled="@(consultando is not null)"
                            aria-label="Ver seguimiento del envío @envio.Id" @onclick="() => VerSeguimientoAsync(envio.Id)">
                            @(consultando == envio.Id ? "Consultando…" : "Ver seguimiento")
                        </button>
                        @if (puedeCancelar && envio.AdmiteCancelacion())
                        {
                            <button class="btn btn-outline-danger" disabled="@(consultando is not null)" @onclick="() => PrepararCancelacion(envio)">Cancelar envío</button>
                        }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
@if (aCancelar is not null)
{
    <section class="card card-body" aria-labelledby="titulo-cancelar">
        <h2 id="titulo-cancelar">Cancelar envío</h2>
        <p>Envío @aCancelar.Id. Se suspenderá la entrega. Si el destinatario ya recibió el paquete, corresponde una devolución.</p>
        <label for="motivo-cancelar">Motivo de cancelación</label>
        <textarea id="motivo-cancelar" class="form-control" maxlength="500" @bind="motivoCancelacion" disabled="@(consultando is not null)"></textarea>
        <div class="mt-2">
            <button class="btn btn-danger" disabled="@(consultando is not null || string.IsNullOrWhiteSpace(motivoCancelacion))" @onclick="ConfirmarCancelacionAsync">Confirmar cancelación</button>
            <button class="btn btn-secondary" disabled="@(consultando is not null)" @onclick="() => aCancelar = null">Volver</button>
        </div>
    </section>
}

@code {
    private readonly CancellationTokenSource cancelacion = new();
    private IReadOnlyList<EnvioResponse> envios = [];
    private string token = "";
    private Guid? consultando;
    private bool cargando = true;
    private string? mensaje;
    private bool puedeCancelar;
    private EnvioResponse? aCancelar;
    private string motivoCancelacion = "";

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        cargando = true; mensaje = null; aCancelar = null; puedeCancelar = false;
        var cancellationToken = cancelacion.Token;
        try
        {
            token = SesionUsuario.ObtenerToken((await AuthenticationState.GetAuthenticationStateAsync()).User);
            cancellationToken.ThrowIfCancellationRequested();
            envios = await ApiClient.ListarEnviosAsync(token, cancellationToken);
            puedeCancelar = (await UsuariosClient.ObtenerPermisosActualesAsync(token, cancellationToken)).Contains("envios.crear");
        }
        catch (OperationCanceledException) when (cancelacion.IsCancellationRequested) { }
        catch (NexoRutaApiException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        { Navigation.NavigateTo("/ingresar?expirada=true", forceLoad: true); }
        catch (NexoRutaApiException exception) when (exception.StatusCode == HttpStatusCode.Forbidden)
        { mensaje = "No tenés permiso para consultar los envíos."; }
        catch (NexoRutaApiException exception) { mensaje = exception.Message; }
        catch (HttpRequestException) { mensaje = "No pudimos cargar tus envíos. Intentá nuevamente más tarde."; }
        catch (OperationCanceledException) { mensaje = "La consulta tardó demasiado. Intentá nuevamente."; }
        finally { cargando = false; }
    }

    private void PrepararCancelacion(EnvioResponse envio)
    {
        if (!puedeCancelar || consultando is not null || !envio.AdmiteCancelacion()) return;
        aCancelar = envio; motivoCancelacion = ""; mensaje = null;
    }

    private async Task ConfirmarCancelacionAsync()
    {
        if (!puedeCancelar || aCancelar is null || consultando is not null || string.IsNullOrWhiteSpace(motivoCancelacion)) return;
        var envio = aCancelar; consultando = envio.Id; mensaje = null;
        try
        {
            await ApiClient.CancelarAsync(envio.Id, envio.Version, motivoCancelacion.Trim(), token, cancelacion.Token);
            aCancelar = null;
            envios = await ApiClient.ListarEnviosAsync(token, cancelacion.Token);
            mensaje = "Cancelación registrada. Consultá el estado actualizado; los bultos no entregados deben volver al depósito.";
        }
        catch (NexoRutaApiException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        { Navigation.NavigateTo("/ingresar?expirada=true", forceLoad: true); }
        catch (NexoRutaApiException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        { mensaje = "No tenés permiso para cancelar este envío."; }
        catch (NexoRutaApiException ex) { mensaje = ex.Message; }
        catch (HttpRequestException) { mensaje = "No se pudo confirmar la cancelación. Consultá el estado antes de reintentar."; }
        catch (OperationCanceledException) when (cancelacion.IsCancellationRequested) { }
        catch (OperationCanceledException) { mensaje = "La solicitud tardó demasiado. Consultá el estado antes de reintentar."; }
        finally { consultando = null; }
    }

    private async Task VerSeguimientoAsync(Guid envioId)
    {
        consultando = envioId;
        mensaje = null;
        try
        {
            if (!Uri.TryCreate(Configuration["Tracking:BaseAddress"], UriKind.Absolute, out var trackingBase))
            {
                mensaje = "El seguimiento no está disponible en este momento.";
                return;
            }
            var url = await ApiClient.ObtenerSeguimientoAsync(envioId, token, trackingBase, cancelacion.Token);
            if (url is null)
                mensaje = "El seguimiento se está generando. Intentá nuevamente en unos segundos";
            else
                Navigation.NavigateTo(url.AbsoluteUri, forceLoad: true);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Gone)
        { mensaje = "El enlace de seguimiento expiró o fue revocado."; }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        { Navigation.NavigateTo("/ingresar?expirada=true", forceLoad: true); }
        catch (NexoRutaApiException exception) when (exception.StatusCode == HttpStatusCode.Forbidden)
        { mensaje = "No tenés permiso para consultar este seguimiento."; }
        catch (HttpRequestException)
        { mensaje = "No pudimos abrir el seguimiento. Intentá nuevamente más tarde."; }
        catch (OperationCanceledException) when (cancelacion.IsCancellationRequested) { }
        catch (OperationCanceledException)
        { mensaje = "La consulta tardó demasiado. Intentá nuevamente."; }
        finally { consultando = null; }
    }

    public void Dispose()
    {
        cancelacion.Cancel();
        cancelacion.Dispose();
    }
}
