@page "/envios"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = ApiPermissionAuthorizationHandler.ShipmentsReadPolicy)]
@rendermode InteractiveServer
@using System.Globalization
@using System.Net
@using Microsoft.AspNetCore.Components.Authorization
@using NexoRuta.ApiClient.Core.Session
@using NexoRuta.ApiClient.Core.Exceptions
@using NexoRuta.ApiClient.Features.Envios.Clients
@using NexoRuta.ApiClient.Features.Envios.Contracts.Responses
@using NexoRuta.ApiClient.Features.Usuarios.Clients
@using NexoRuta.ApiClient.Features.Operadores.Clients
@using NexoRuta.ApiClient.Features.IdentidadVisual
@using NexoRuta.ApiClient.Features.IdentidadVisual.Contracts.Responses
@using NexoRuta.Commerce.Components.Features.Envios.Shared
@inject EnviosApiClient ApiClient
@inject UsuariosApiClient UsuariosClient
@inject OperadoresApiClient OperadoresClient
@inject AuthenticationStateProvider AuthenticationState
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@implements IDisposable

<PageTitle>Mis envíos | NexoRuta</PageTitle>
<main class="nr-shipments-page" aria-labelledby="shipments-title">
    <header class="nr-shipments-heading">
        <div>
            <p class="nr-shipments-eyebrow">COMERCIO</p>
            <h1 id="shipments-title">Mis envíos</h1>
            <p>Encontrá tus pedidos y consultá su estado</p>
        </div>
        <div class="nr-shipments-page-actions">
            <a class="btn btn-primary" href="/envios/crear"><span aria-hidden="true">＋</span> Crear envío</a>
            <a class="btn btn-outline-primary" href="/envios/importar"><span aria-hidden="true">↑</span> Importar CSV</a>
            <button class="btn btn-outline-secondary nr-shipments-refresh" type="button" aria-label="Actualizar lista"
                    aria-controls="shipments-list" disabled="@(cargando || consultando is not null)" @onclick="CargarAsync">
                <span aria-hidden="true">↻</span>
            </button>
        </div>
    </header>

    @if (mensaje is not null && !errorListado)
    {
        <p class="nr-shipments-message" role="status">@mensaje</p>
    }

    @if (cargando && !listadoCargado)
    {
        <div id="shipments-list" class="nr-shipments-initial-load" aria-busy="true" aria-label="Cargando envíos">
            <p class="visually-hidden" role="status">Cargando envíos.</p>
            <div class="nr-shipments-skeleton" aria-hidden="true"><span></span><span></span><span></span></div>
        </div>
    }
    else
    {
        <section id="shipments-list" class="nr-shipments-content" aria-label="Lista de envíos" aria-busy="@(cargando ? "true" : "false")">
            @if (cargando)
            {
                <p class="visually-hidden" role="status">Actualizando la lista de envíos.</p>
            }
            @if (errorListado)
            {
                <div class="nr-shipments-query-error" role="alert">
                    <span>@errorListadoMensaje</span>
                    <button class="btn btn-outline-primary" type="button" disabled="@cargando" @onclick="CargarAsync">Reintentar</button>
                </div>
            }

            @if (envios.Count == 0)
            {
                @if (!errorListado)
                {
                    <section class="nr-shipments-empty" aria-labelledby="shipments-empty-title">
                        <h2 id="shipments-empty-title">Todavía no tenés envíos</h2>
                        <a class="btn btn-primary" href="/envios/crear">Crear envío</a>
                    </section>
                }
            }
            else
            {
                <div class="nr-shipments-toolbar">
                    <div class="nr-shipments-search-wrap">
                        <label class="visually-hidden" for="shipments-search">Buscar por destinatario, referencia o dirección</label>
                        <span aria-hidden="true" class="nr-shipments-search-icon">⌕</span>
                        <input id="shipments-search" class="form-control nr-shipments-search" type="search"
                               placeholder="Buscar por destinatario, referencia o dirección"
                               value="@busqueda" @oninput="CambiarBusqueda" />
                    </div>
                    <div>
                        <label class="visually-hidden" for="shipments-operator">Filtrar por operador</label>
                        <select id="shipments-operator" class="form-select" value="@operadorSeleccionado" @onchange="CambiarOperador">
                            <option value="">Todos los operadores</option>
                            @foreach (var operador in OperadoresDisponibles)
                            {
                                <option value="@operador.Id">@operador.Nombre</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="nr-shipments-status-tabs" role="group" aria-label="Filtrar envíos por estado">
                    @foreach (var pestaña in PestañasEstado)
                    {
                        <button type="button" class="nr-shipments-status-tab @(filtroEstado == pestaña.Key ? "is-selected" : null)"
                                aria-pressed="@(filtroEstado == pestaña.Key ? "true" : "false")" @onclick="() => CambiarEstado(pestaña.Key)">
                            <span>@pestaña.Label</span><span class="nr-shipments-tab-count">@ContarEstado(pestaña.Key)</span>
                        </button>
                    }
                </div>

                @if (ResultadosFiltrados.Count == 0)
                {
                    <section class="nr-shipments-empty nr-shipments-no-results" aria-labelledby="shipments-no-results-title">
                        <h2 id="shipments-no-results-title">No hay resultados para estos filtros</h2>
                        <button type="button" class="btn btn-outline-primary" @onclick="LimpiarFiltros">Limpiar búsqueda y filtros</button>
                    </section>
                }
                else
                {
                    <div class="nr-shipments-table-shell">
                        <table class="nr-shipments-table">
                            <caption class="visually-hidden">Envíos del comercio y su estado actual</caption>
                            <colgroup>
                                <col class="nr-col-shipment" /><col class="nr-col-recipient" /><col class="nr-col-destination" />
                                <col class="nr-col-operator" /><col class="nr-col-status" /><col class="nr-col-actions" />
                            </colgroup>
                            <thead>
                                <tr><th scope="col">Envío</th><th scope="col">Destinatario</th><th scope="col">Destino</th>
                                    <th scope="col">Operador</th><th scope="col">Estado</th><th scope="col"><span class="visually-hidden">Acciones</span></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var envio in EnviosDePagina)
                                {
                                    <tr @key="envio.Id">
                                        <th scope="row" data-label="Envío">
                                            <div class="nr-shipment-identity">
                                                <strong class="nr-shipment-reference">@(envio.ReferenciaExterna ?? $"Envío #{IdCorto(envio.Id)}")</strong>
                                                @if (envio.Bultos.Count > 0) { <span class="nr-shipment-package-summary">@ResumenBultos(envio)</span> }
                                            </div>
                                        </th>
                                        <td data-label="Destinatario">
                                            <div class="nr-shipment-recipient">
                                                <strong>@envio.DestinatarioNombre</strong>
                                                @if (!string.IsNullOrWhiteSpace(envio.DestinatarioEmail)) { <a href="mailto:@envio.DestinatarioEmail">@envio.DestinatarioEmail</a> }
                                            </div>
                                        </td>
                                        <td data-label="Destino">
                                            <div class="nr-shipment-destination">
                                                <span class="nr-shipment-address">@envio.Direccion</span>
                                                @if (DestinoPendiente(envio)) { <span class="nr-shipment-destination-pending">Destino pendiente</span> }
                                                @if (puedeConfirmarDestino && AdmiteConfirmarDestino(envio))
                                                { <a href="/envios/@envio.Id/destino">Ubicación del destino</a> }
                                            </div>
                                        </td>
                                        <td data-label="Operador">
                                            @if (identidades.TryGetValue(envio.OperadorId, out var marca))
                                            {
                                                <div class="nr-shipment-operator">
                                                    @if (marca.LogoContenido is { Length: > 0 } && marca.LogoTipoContenido is "image/png" or "image/jpeg")
                                                    { <img class="nr-shipment-operator-logo" src="@LogoDataUri(marca)" alt="" /> }
                                                    else { <span class="nr-shipment-operator-initials" aria-hidden="true">@Iniciales(marca.Nombre)</span> }
                                                    <div class="nr-shipment-operator-copy">
                                                        <strong>@marca.Nombre</strong>
                                                        @if (marca.CorreoPublico is not null || marca.TelefonoPublico is not null)
                                                        {
                                                            <details class="nr-shipment-operator-contact">
                                                                <summary>Contacto</summary>
                                                                <div>
                                                                    @if (marca.CorreoPublico is not null) { <a href="mailto:@marca.CorreoPublico">@marca.CorreoPublico</a> }
                                                                    @if (marca.TelefonoPublico is not null) { <a href="tel:@TelefonoHref(marca.TelefonoPublico)">@marca.TelefonoPublico</a> }
                                                                </div>
                                                            </details>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="nr-shipment-operator">
                                                    <span class="nr-shipment-operator-initials" aria-hidden="true">@Iniciales(envio.OperadorNombre)</span>
                                                    <strong class="nr-shipment-operator-name">@envio.OperadorNombre</strong>
                                                </div>
                                            }
                                        </td>
                                        <td data-label="Estado"><span class="nr-shipment-status @ClaseEstado(envio.Estado)">@EstadoLegible(envio.Estado)</span></td>
                                        <td data-label="Acciones" class="nr-shipment-actions-cell">
                                            <div class="nr-shipment-actions">
                                                <button type="button" class="nr-shipment-track-link" disabled="@(consultando is not null)"
                                                        aria-label="Ver seguimiento del envío @IdCorto(envio.Id)" @onclick="() => VerSeguimientoAsync(envio.Id)">
                                                    @(consultando == envio.Id ? "Consultando…" : "Ver seguimiento")
                                                </button>
                                                <AccionesEnvio EnvioId="envio.Id" PuedeCancelar="@(puedeCancelar && envio.AdmiteCancelacion())"
                                                               OnCancelar="() => PrepararCancelacionAsync(envio)" />
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <footer class="nr-shipments-footer">
                            <p class="nr-shipments-range" role="status">Mostrando @PrimerResultado–@UltimoResultado de @ResultadosFiltrados.Count envíos</p>
                            @if (TotalPaginas > 1)
                            {
                                <nav class="nr-shipments-pagination" aria-label="Paginación de envíos">
                                    <button type="button" class="nr-page-button" aria-label="Página anterior" disabled="@(paginaActual == 1)" @onclick="() => IrAPagina(paginaActual - 1)">‹</button>
                                    @foreach (var numero in NumerosPagina)
                                    {
                                        <button type="button" class="nr-page-button @(paginaActual == numero ? "is-current" : null)"
                                                aria-label="Página @numero" aria-current="@(paginaActual == numero ? "page" : null)" @onclick="() => IrAPagina(numero)">@numero</button>
                                    }
                                    <button type="button" class="nr-page-button" aria-label="Página siguiente" disabled="@(paginaActual == TotalPaginas)" @onclick="() => IrAPagina(paginaActual + 1)">›</button>
                                </nav>
                            }
                        </footer>
                    </div>
                }
            }
        </section>
    }
</main>

@if (aCancelar is not null)
{
    <section class="nr-cancel-shipment-panel" aria-labelledby="titulo-cancelar" tabindex="-1">
        <h2 id="titulo-cancelar">Cancelar envío</h2>
        <p>Envío @(aCancelar.ReferenciaExterna ?? $"#{IdCorto(aCancelar.Id)}"). Se suspenderá la entrega. Si el destinatario ya recibió el paquete, corresponde una devolución.</p>
        <label for="motivo-cancelar">Motivo de cancelación</label>
        <textarea id="motivo-cancelar" class="form-control" maxlength="500" @bind="motivoCancelacion" disabled="@(consultando is not null)"></textarea>
        <div class="nr-cancel-shipment-actions">
            <button class="btn btn-danger" disabled="@(consultando is not null || string.IsNullOrWhiteSpace(motivoCancelacion))" @onclick="ConfirmarCancelacionAsync">Confirmar cancelación</button>
            <button class="btn btn-outline-secondary" disabled="@(consultando is not null)" @onclick="() => aCancelar = null">Volver</button>
        </div>
    </section>
}

@code {
    private const int TamanoPagina = 6;
    private static readonly (string Key, string Label)[] PestañasEstado =
    [
        ("Todos", "Todos"), ("Admitidos", "Admitidos"), ("EnDeposito", "En depósito"),
        ("EnTransito", "En tránsito"), ("Entregados", "Entregados"), ("Incidencias", "Incidencias"), ("Cancelados", "Cancelados")
    ];
    private readonly CancellationTokenSource cancelacion = new();
    private IReadOnlyList<EnvioResponse> envios = [];
    private string token = "";
    private Guid? consultando;
    private bool cargando = true;
    private bool listadoCargado;
    private bool errorListado;
    private string errorListadoMensaje = "No pudimos cargar tus envíos. Intentá nuevamente.";
    private string? mensaje;
    private bool puedeCancelar;
    private bool puedeConfirmarDestino;
    private string busqueda = "";
    private string operadorSeleccionado = "";
    private string filtroEstado = "Todos";
    private int paginaActual = 1;
    private IReadOnlyDictionary<Guid, IdentidadVisualPublicaResponse> identidades = new Dictionary<Guid, IdentidadVisualPublicaResponse>();
    private EnvioResponse? aCancelar;
    private string motivoCancelacion = "";

    private IEnumerable<EnvioResponse> ResultadosBase => envios.Where(CoincideBusqueda)
        .Where(envio => string.IsNullOrEmpty(operadorSeleccionado) || envio.OperadorId.ToString() == operadorSeleccionado);
    private IReadOnlyList<EnvioResponse> ResultadosFiltrados => ResultadosBase.Where(envio => PerteneceEstado(envio, filtroEstado)).ToArray();
    private IReadOnlyList<EnvioResponse> EnviosDePagina => ResultadosFiltrados.Skip((paginaActual - 1) * TamanoPagina).Take(TamanoPagina).ToArray();
    private IEnumerable<(Guid Id, string Nombre)> OperadoresDisponibles => envios
        .GroupBy(envio => envio.OperadorId)
        .Select(grupo => (grupo.Key, grupo.First().OperadorNombre))
        .OrderBy(operador => operador.OperadorNombre, StringComparer.CurrentCultureIgnoreCase);
    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(ResultadosFiltrados.Count / (double)TamanoPagina));
    private int PrimerResultado => ResultadosFiltrados.Count == 0 ? 0 : (paginaActual - 1) * TamanoPagina + 1;
    private int UltimoResultado => Math.Min(paginaActual * TamanoPagina, ResultadosFiltrados.Count);
    private IEnumerable<int> NumerosPagina
    {
        get
        {
            var inicio = Math.Max(1, Math.Min(paginaActual - 2, TotalPaginas - 4));
            return Enumerable.Range(inicio, Math.Min(5, TotalPaginas - inicio + 1));
        }
    }

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        cargando = true; mensaje = null; errorListado = false; aCancelar = null;
        puedeCancelar = false; puedeConfirmarDestino = false;
        identidades = new Dictionary<Guid, IdentidadVisualPublicaResponse>();
        var listaRecibida = false;
        var cancellationToken = cancelacion.Token;
        try
        {
            token = SesionUsuario.ObtenerToken((await AuthenticationState.GetAuthenticationStateAsync()).User);
            cancellationToken.ThrowIfCancellationRequested();
            envios = await ApiClient.ListarEnviosAsync(token, cancellationToken);
            listaRecibida = true; listadoCargado = true;
            var results = await Task.WhenAll(envios.Select(item => item.OperadorId).Distinct()
                .Select(operatorId => ObtenerIdentidadAsync(operatorId, cancellationToken)));
            identidades = results.Where(result => result.Identity is not null)
                .ToDictionary(result => result.OperatorId, result => result.Identity!);
            if (results.Any(result => result.Failed))
                mensaje = "No pudimos cargar la identidad de uno o más operadores. Se muestra su nombre.";
            var permisos = await UsuariosClient.ObtenerPermisosActualesAsync(token, cancellationToken);
            puedeCancelar = permisos.Contains("envios.crear");
            puedeConfirmarDestino = puedeCancelar;
            paginaActual = Math.Clamp(paginaActual, 1, TotalPaginas);
        }
        catch (OperationCanceledException) when (cancelacion.IsCancellationRequested) { }
        catch (NexoRutaApiException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized)
        { Navigation.NavigateTo("/ingresar?expirada=true", forceLoad: true); }
        catch (NexoRutaApiException exception) when (exception.StatusCode == HttpStatusCode.Forbidden)
        {
            mensaje = "No tenés permiso para consultar los envíos.";
            if (!listaRecibida) { errorListado = true; errorListadoMensaje = mensaje; }
        }
        catch (NexoRutaApiException exception)
        {
            mensaje = exception.Message;
            if (!listaRecibida) { errorListado = true; errorListadoMensaje = "No pudimos cargar tus envíos. Intentá nuevamente."; }
        }
        catch (HttpRequestException)
        {
            mensaje = "No pudimos cargar tus envíos. Intentá nuevamente más tarde.";
            if (!listaRecibida) { errorListado = true; errorListadoMensaje = mensaje; }
        }
        catch (OperationCanceledException)
        {
            mensaje = "La consulta tardó demasiado. Intentá nuevamente.";
            if (!listaRecibida) { errorListado = true; errorListadoMensaje = mensaje; }
        }
        finally { cargando = false; }
    }

    private async Task<(Guid OperatorId, IdentidadVisualPublicaResponse? Identity, bool Failed)> ObtenerIdentidadAsync(
        Guid operatorId, CancellationToken cancellationToken)
    {
        try
        {
            return (operatorId, await OperadoresClient.ObtenerIdentidadVisualAsync(operatorId, token, cancellationToken), false);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { throw; }
        catch (NexoRutaApiException exception) when (exception.StatusCode == HttpStatusCode.Unauthorized) { throw; }
        catch (Exception exception) when (exception is NexoRutaApiException or HttpRequestException)
        { return (operatorId, null, true); }
    }

    private bool CoincideBusqueda(EnvioResponse envio)
    {
        if (string.IsNullOrWhiteSpace(busqueda)) return true;
        return Contiene(envio.DestinatarioNombre, busqueda) || Contiene(envio.DestinatarioEmail, busqueda)
            || Contiene(envio.ReferenciaExterna, busqueda) || Contiene(envio.Direccion, busqueda);
    }

    private static bool Contiene(string? texto, string consulta) => texto?.Contains(consulta.Trim(), StringComparison.OrdinalIgnoreCase) == true;

    private int ContarEstado(string categoria) => categoria == "Todos"
        ? ResultadosBase.Count() : ResultadosBase.Count(envio => PerteneceEstado(envio, categoria));

    private static bool PerteneceEstado(EnvioResponse envio, string categoria) => categoria switch
    {
        "Todos" => true,
        "Admitidos" => envio.Estado == "Admitido",
        "EnDeposito" => envio.Estado == "EnDeposito",
        "EnTransito" => envio.Estado is "AsignadoRuta" or "EnTransito" or "NoEntregado" or "Reprogramado" or "EnDevolucion",
        "Entregados" => envio.Estado is "Entregado" or "EntregaPendienteValidacion" or "EntregaSinValidacion" or "Devuelto",
        "Incidencias" => envio.Estado == "Extraviado",
        "Cancelados" => envio.Estado == "Cancelado",
        _ => false
    };

    private Task CambiarBusqueda(ChangeEventArgs args) { busqueda = args.Value?.ToString() ?? ""; paginaActual = 1; return Task.CompletedTask; }
    private Task CambiarOperador(ChangeEventArgs args) { operadorSeleccionado = args.Value?.ToString() ?? ""; paginaActual = 1; return Task.CompletedTask; }
    private Task CambiarEstado(string estado) { filtroEstado = estado; paginaActual = 1; return Task.CompletedTask; }
    private Task IrAPagina(int pagina) { paginaActual = Math.Clamp(pagina, 1, TotalPaginas); return Task.CompletedTask; }
    private Task LimpiarFiltros() { busqueda = ""; operadorSeleccionado = ""; filtroEstado = "Todos"; paginaActual = 1; return Task.CompletedTask; }

    private static string EstadoLegible(string estado) => estado switch
    {
        "Admitido" => "Admitido", "EnDeposito" => "En depósito", "AsignadoRuta" => "Asignado a ruta",
        "EnTransito" => "En tránsito", "Entregado" => "Entregado", "NoEntregado" => "No entregado",
        "Reprogramado" => "Reprogramado", "EnDevolucion" => "En devolución", "Devuelto" => "Devuelto",
        "Extraviado" => "Extraviado", "EntregaPendienteValidacion" => "Entrega pendiente de validación",
        "EntregaSinValidacion" => "Entrega sin validación", "Cancelado" => "Cancelado", _ => estado
    };

    private static string ClaseEstado(string estado) => estado switch
    {
        "Admitido" => "nr-shipment-status--admitted", "EnDeposito" => "nr-shipment-status--depot",
        "AsignadoRuta" or "EnTransito" or "NoEntregado" or "Reprogramado" or "EnDevolucion" => "nr-shipment-status--transit",
        "Entregado" or "EntregaPendienteValidacion" or "EntregaSinValidacion" or "Devuelto" => "nr-shipment-status--complete",
        "Cancelado" or "Extraviado" => "nr-shipment-status--closed", _ => "nr-shipment-status--other"
    };

    private static bool DestinoPendiente(EnvioResponse envio) => !envio.DestinoConfirmado && (envio.Estado is "Admitido" or "EnDeposito");
    private static bool AdmiteConfirmarDestino(EnvioResponse envio) => envio.Estado == "Admitido" || envio.Estado == "EnDeposito" && !envio.DestinoConfirmado;

    private static string ResumenBultos(EnvioResponse envio)
    {
        var pesoGramos = envio.Bultos.Sum(bulto => bulto.PesoGramos);
        var peso = pesoGramos > 0 ? $" · {(pesoGramos / 1000m).ToString("0.##", CultureInfo.GetCultureInfo("es-UY"))} kg" : "";
        return $"{envio.Bultos.Count} {(envio.Bultos.Count == 1 ? "bulto" : "bultos")}{peso}";
    }

    private static string IdCorto(Guid id) => id.ToString("N")[..8].ToUpperInvariant();
    private static string Iniciales(string nombre)
    {
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return partes.Length switch { 0 => "?", 1 => partes[0][..1].ToUpperInvariant(), _ => string.Concat(partes[0][..1], partes[^1][..1]).ToUpperInvariant() };
    }
    private static string? LogoDataUri(IdentidadVisualPublicaResponse identity)
        => identity.LogoContenido is { Length: > 0 } bytes && identity.LogoTipoContenido is "image/png" or "image/jpeg"
            ? $"data:{identity.LogoTipoContenido};base64,{Convert.ToBase64String(bytes)}" : null;
    private static string TelefonoHref(string phone) => new(phone.Where(character => character is >= '0' and <= '9' || character == '+').ToArray());

    private Task PrepararCancelacionAsync(EnvioResponse envio)
    {
        if (!puedeCancelar || consultando is not null || !envio.AdmiteCancelacion()) return Task.CompletedTask;
        aCancelar = envio; motivoCancelacion = ""; mensaje = null;
        return Task.CompletedTask;
    }

    private async Task ConfirmarCancelacionAsync()
    {
        if (!puedeCancelar || aCancelar is null || consultando is not null || string.IsNullOrWhiteSpace(motivoCancelacion)) return;
        var envio = aCancelar; consultando = envio.Id; mensaje = null;
        try
        {
            await ApiClient.CancelarAsync(envio.Id, envio.Version, motivoCancelacion.Trim(), token, cancelacion.Token);
            aCancelar = null; envios = await ApiClient.ListarEnviosAsync(token, cancelacion.Token); listadoCargado = true;
            paginaActual = Math.Clamp(paginaActual, 1, TotalPaginas);
            mensaje = "Cancelación registrada. Consultá el estado actualizado; los bultos no entregados deben volver al depósito.";
        }
        catch (NexoRutaApiException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        { Navigation.NavigateTo("/ingresar?expirada=true", forceLoad: true); }
        catch (NexoRutaApiException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        { mensaje = "No tenés permiso para cancelar este envío."; }
        catch (NexoRutaApiException ex) { mensaje = ex.Message; }
        catch (HttpRequestException) { mensaje = "No se pudo confirmar la cancelación. Consultá el estado antes de reintentar."; }
        catch (OperationCanceledException) when (cancelacion.IsCancellationRequested) { }
        catch (OperationCanceledException) { mensaje = "La solicitud tardó demasiado. Consultá el estado antes de reintentar."; }
        finally { consultando = null; }
    }

    private async Task VerSeguimientoAsync(Guid envioId)
    {
        consultando = envioId; mensaje = null;
        try
        {
            if (!Uri.TryCreate(Configuration["Tracking:BaseAddress"], UriKind.Absolute, out var trackingBase))
            { mensaje = "El seguimiento no está disponible en este momento."; return; }
            var url = await ApiClient.ObtenerSeguimientoAsync(envioId, token, trackingBase, cancelacion.Token);
            if (url is null) mensaje = "El seguimiento se está generando. Intentá nuevamente en unos segundos";
            else Navigation.NavigateTo(url.AbsoluteUri, forceLoad: true);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Gone)
        { mensaje = "El enlace de seguimiento expiró o fue revocado."; }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        { Navigation.NavigateTo("/ingresar?expirada=true", forceLoad: true); }
        catch (NexoRutaApiException exception) when (exception.StatusCode == HttpStatusCode.Forbidden)
        { mensaje = "No tenés permiso para consultar este seguimiento."; }
        catch (HttpRequestException) { mensaje = "No pudimos abrir el seguimiento. Intentá nuevamente más tarde."; }
        catch (OperationCanceledException) when (cancelacion.IsCancellationRequested) { }
        catch (OperationCanceledException) { mensaje = "La consulta tardó demasiado. Intentá nuevamente."; }
        finally { consultando = null; }
    }

    public void Dispose() { cancelacion.Cancel(); cancelacion.Dispose(); }
}
