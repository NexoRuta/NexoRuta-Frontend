@page "/envios/{EnvioId:guid}/destino"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = ApiPermissionAuthorizationHandler.ShipmentsCreatePolicy)]
@rendermode InteractiveServer
@using System.Net
@using Microsoft.AspNetCore.Components.Authorization
@using NexoRuta.ApiClient.Core.Session
@using NexoRuta.ApiClient.Features.Envios.Clients
@using NexoRuta.ApiClient.Features.Envios.Contracts.Responses
@using NexoRuta.Commerce.Components.Features.Envios.Shared
@inject DestinosEnvioApiClient Destinos
@inject AuthenticationStateProvider AuthenticationState
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Ubicación del destino | NexoRuta</PageTitle>
<header class="nr-page-heading">
    <div>
        <p class="nr-eyebrow">ENVÍOS · DESTINO</p>
        <h1>Ubicación del destino</h1>
        <p>Buscá la dirección, revisá el punto y confirmalo.</p>
    </div>
    <div class="nr-page-actions"><a class="btn btn-outline-secondary" href="/envios">Volver a mis envíos</a></div>
</header>

@if (mensaje is not null)
{
    <p class="alert @(mensajeError ? "alert-danger" : "alert-success")" role="@(mensajeError ? "alert" : "status")">@mensaje</p>
}
@if (destino is null && ocupado)
{
    <div class="nr-detail-skeleton" aria-busy="true" aria-label="Cargando ubicación del destino">
        <p class="visually-hidden" role="status">Consultando dirección y punto de entrega.</p><span></span><span></span><span></span>
    </div>
}
else if (destino is not null)
{
    <section class="nr-destination-layout" aria-label="Ubicación del envío">
        <div class="nr-destination-map-column">
            <div class="nr-destination-registered">
                <p class="nr-eyebrow">DIRECCIÓN REGISTRADA</p>
                <h2>@destino.Direccion</h2>
                @if (destino.ConfirmadaEnUtc is not null)
                {
                    <p class="nr-destination-confirmed">Ubicación confirmada · @destino.ConfirmadaEnUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                }
            </div>
            @if (!PuedeGestionarDestino)
            {
                <p class="nr-destination-readonly" role="status">El envío ya no admite cambios de ubicación. El punto se muestra solo para consulta.</p>
            }
            else if (destino.Estado == "EnDeposito")
            {
                <p class="nr-destination-readonly" role="status">El envío ya fue recibido. Confirmá la ubicación pendiente para habilitar la planificación.</p>
            }
            <SelectorDestino @key="EnvioId" Latitud="punto.Latitud" Longitud="punto.Longitud"
                             Editable="PuedeGestionarDestino" Bloqueado="ocupado" PuntoCambiado="ActualizarPunto" />
        </div>

        <aside class="nr-destination-review" aria-labelledby="destino-revision-titulo">
            <p class="nr-eyebrow">REVISIÓN</p>
            <h2 id="destino-revision-titulo">Punto de entrega</h2>
            <p class="nr-destination-point-state">@EstadoPunto</p>
            @if (!string.IsNullOrWhiteSpace(descripcionProvisional))
            {
                <p class="nr-destination-point-label">@descripcionProvisional</p>
            }
            @if (PuedeGestionarDestino)
            {
                <p class="nr-destination-hint">La selección queda provisional hasta que confirmes. El servidor valida el punto y la versión del envío.</p>
                <label class="nr-destination-review-check" for="destino-revisado">
                    <input id="destino-revisado" type="checkbox" checked="@revisado" disabled="@(!PuntoValido || ocupado)" @onchange="CambiarRevision" />
                    <span>Revisé que el marcador coincide con la dirección registrada.</span>
                </label>
                <button type="button" class="btn btn-primary nr-destination-primary" disabled="@(!PuedeConfirmar)" @onclick="ConfirmarAsync">
                    @(destino.ConfirmadaEnUtc is null ? "Confirmar ubicación" : "Confirmar nueva ubicación")
                </button>
            }
            else
            {
                <p class="nr-destination-hint">La ubicación es de consulta; no se puede modificar desde este estado.</p>
            }
        </aside>
    </section>
}

@code {
    [Parameter] public Guid EnvioId { get; set; }
    private CancellationTokenSource solicitudes = new();
    private DestinoEnvioResponse? destino;
    private PuntoFormulario punto = new();
    private string token = "";
    private string? mensaje, descripcionProvisional;
    private bool ocupado, revisado, puntoPersistido, mensajeError;
    private bool PuedeGestionarDestino => destino?.Estado == "Admitido"
        || destino is { Estado: "EnDeposito", ConfirmadaEnUtc: null };
    private bool PuntoValido => punto.Latitud is { } lat && double.IsFinite(lat) && lat is >= -90 and <= 90
        && punto.Longitud is { } lon && double.IsFinite(lon) && lon is >= -180 and <= 180;
    private bool PuedeConfirmar => !ocupado && revisado && PuedeGestionarDestino && PuntoValido;
    private string EstadoPunto => !PuntoValido ? "Todavía no seleccionaste un punto." : puntoPersistido
        ? "Punto registrado · pendiente de revisar." : string.IsNullOrWhiteSpace(descripcionProvisional)
            ? "Punto seleccionado en el mapa · pendiente de confirmar." : "Sugerencia seleccionada · pendiente de confirmar.";

    protected override async Task OnParametersSetAsync()
    {
        solicitudes.Cancel(); solicitudes.Dispose(); solicitudes = new();
        var ct = solicitudes.Token;
        destino = null; punto = new(); descripcionProvisional = null; puntoPersistido = revisado = false; mensaje = null; mensajeError = false;
        ocupado = true;
        try
        {
            token = SesionUsuario.ObtenerToken((await AuthenticationState.GetAuthenticationStateAsync()).User);
            var actual = await Destinos.ObtenerAsync(EnvioId, token, ct);
            if (ct.IsCancellationRequested) return;
            destino = actual;
            punto.Latitud = actual.Latitud; punto.Longitud = actual.Longitud;
            puntoPersistido = PuntoValido;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (HttpRequestException ex) { if (!ct.IsCancellationRequested) MostrarError(ex); }
        finally { if (!ct.IsCancellationRequested) ocupado = false; }
    }

    private void ActualizarPunto((double? Latitud, double? Longitud, string? Descripcion) seleccionado)
    {
        punto.Latitud = seleccionado.Latitud;
        punto.Longitud = seleccionado.Longitud;
        descripcionProvisional = seleccionado.Descripcion;
        puntoPersistido = false;
        revisado = false;
        mensaje = null; mensajeError = false;
    }

    private void CambiarRevision(ChangeEventArgs args) => revisado = args.Value is bool value && value;

    private async Task ConfirmarAsync()
    {
        var actual = destino;
        if (!PuedeConfirmar || actual is null || punto.Latitud is not { } latitud || punto.Longitud is not { } longitud) return;
        var ct = solicitudes.Token;
        ocupado = true; mensaje = null; mensajeError = false;
        var postAceptado = false;
        try
        {
            await Destinos.ConfirmarAsync(EnvioId, actual.Version, latitud, longitud, token, ct);
            postAceptado = true;
            destino = await Destinos.ObtenerAsync(EnvioId, token, ct);
            if (ct.IsCancellationRequested) return;
            punto.Latitud = destino.Latitud; punto.Longitud = destino.Longitud;
            puntoPersistido = PuntoValido; descripcionProvisional = null; revisado = false;
            mensaje = "Ubicación confirmada. El punto quedó listo para su planificación.";
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (HttpRequestException) when (postAceptado)
        {
            if (!ct.IsCancellationRequested)
            {
                mensaje = "El servidor aceptó la confirmación, pero no pudimos actualizar la pantalla. Recargá para verificar el estado.";
                mensajeError = false;
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Conflict)
        {
            revisado = false;
            await ActualizarDestinoTrasConflicto(ct);
            if (!ct.IsCancellationRequested) { mensaje = "El envío cambió mientras revisabas el punto. Actualizamos sus datos; verificá nuevamente la selección antes de confirmar."; mensajeError = true; }
        }
        catch (HttpRequestException ex) when (ex.StatusCode is null || (int)ex.StatusCode >= 500)
        {
            await VerificarResultadoIncierto(latitud, longitud, ct);
        }
        catch (HttpRequestException ex) { if (!ct.IsCancellationRequested) MostrarError(ex); }
        finally { if (!ct.IsCancellationRequested) ocupado = false; }
    }

    private async Task ActualizarDestinoTrasConflicto(CancellationToken ct)
    {
        try { destino = await Destinos.ObtenerAsync(EnvioId, token, ct); }
        catch (HttpRequestException) { }
    }

    private async Task VerificarResultadoIncierto(double latitud, double longitud, CancellationToken ct)
    {
        try
        {
            var actual = await Destinos.ObtenerAsync(EnvioId, token, ct);
            if (ct.IsCancellationRequested) return;
            destino = actual;
            var mismaUbicacion = actual.ConfirmadaEnUtc is not null && actual.Latitud is { } guardadaLat
                && actual.Longitud is { } guardadaLon && Math.Abs(guardadaLat - latitud) < 0.0000001
                && Math.Abs(guardadaLon - longitud) < 0.0000001;
            if (mismaUbicacion)
            {
                punto.Latitud = actual.Latitud; punto.Longitud = actual.Longitud; puntoPersistido = true;
                descripcionProvisional = null; revisado = false;
                mensaje = "La ubicación figura confirmada en el servidor. La respuesta anterior no llegó a la pantalla.";
                mensajeError = false;
            }
            else
            {
                mensaje = "No recibimos una confirmación. La selección se conserva; no la volvimos a enviar. Actualizá antes de intentar otra vez.";
                mensajeError = true;
            }
        }
        catch (HttpRequestException)
        {
            if (!ct.IsCancellationRequested) { mensaje = "No recibimos respuesta ni pudimos verificar el estado. La selección se conserva; actualizá antes de repetir."; mensajeError = true; }
        }
    }

    private void MostrarError(HttpRequestException ex)
    {
        if (ex.StatusCode == HttpStatusCode.Unauthorized) { Navigation.NavigateTo("/ingresar?expirada=true", forceLoad: true); return; }
        mensajeError = true;
        mensaje = ex.StatusCode switch
        {
            HttpStatusCode.NotFound => "El envío no está disponible en tu comercio.",
            HttpStatusCode.Forbidden => "No tenés permiso para gestionar el destino.",
            HttpStatusCode.Conflict => "El envío cambió. Actualizá sus datos antes de confirmar.",
            HttpStatusCode.UnprocessableEntity or HttpStatusCode.BadRequest => "El servidor rechazó el punto. Revisá el marcador y volvé a seleccionar la ubicación.",
            _ => "No pudimos consultar el envío. Revisá tu conexión e intentá actualizar la pantalla."
        };
    }

    public void Dispose() { solicitudes.Cancel(); solicitudes.Dispose(); }
    private sealed class PuntoFormulario { public double? Latitud { get; set; } public double? Longitud { get; set; } }
}
