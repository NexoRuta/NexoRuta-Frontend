@page "/"

@using NexoRuta.ApiClient.Features.Envios.Contracts.Requests
@using NexoRuta.ApiClient.Features.Envios.Contracts.Responses
@using NexoRuta.ApiClient.Features.Operadores.Contracts.Responses
@using NexoRuta.ApiClient.Features.Usuarios.Contracts.Responses
@using NexoRuta.ApiClient.Core.Session
@using NexoRuta.ApiClient.Core.Exceptions
@using NexoRuta.ApiClient.Features.Envios.Clients
@using NexoRuta.ApiClient.Features.Operadores.Clients
@using NexoRuta.ApiClient.Features.Usuarios.Clients
@using Microsoft.AspNetCore.Components.Authorization
@inject EnviosApiClient ApiClient
@inject UsuariosApiClient UsuariosClient
@inject OperadoresApiClient OperadoresClient
@inject AuthenticationStateProvider AuthenticationState
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Alta de envío | NexoRuta</PageTitle>
<h1>Alta de envío</h1>
@if (usuarioActual is not null)
{
    <p>Comercio: <strong>@usuarioActual.ComercioNombre</strong> · Cuenta:
        @usuarioActual.UsuarioEmail@(usuarioActual.EsPropietario ? " (dueño)" : "")</p>
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <p class="alert alert-danger" role="alert">@error</p>
    }
    @if (creado is not null)
    {
        <p class="alert alert-success" role="status">Envío <code>@creado.Id</code> guardado para
            @creado.ComercioNombre con @creado.OperadorNombre; bulto @creado.CodigoBulto.</p>
        }
        @if (usuarioActual is not null && operadores.Count == 0 && error is null)
        {
            <p class="alert alert-warning" role="status">Todavía no hay operadores registrados para crear un envío.</p>
        }

        <EditForm Model="formulario" OnValidSubmit="CrearAsync" FormName="crear-envio">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <fieldset disabled="@(enviando || usuarioActual is null || operadores.Count == 0)">
                <label for="envio-operador">Operador</label>
                <InputSelect id="envio-operador" @bind-Value="formulario.OperadorId">
                    <option value="">Seleccioná un operador</option>
                    @foreach (var operador in operadores)
                    {
                        <option value="@operador.OperadorId">@operador.Nombre</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => formulario.OperadorId" />
                <h2>Destinatario</h2>
                <label>Nombre
                    <InputText @bind-Value="formulario.DestinatarioNombre" />
                </label>
                <ValidationMessage For="() => formulario.DestinatarioNombre" />
                <label>Dirección
                    <InputText @bind-Value="formulario.Direccion" />
                </label>
                <ValidationMessage For="() => formulario.Direccion" />
                <h2>Bulto</h2>
                <label>Código
                    <InputText @bind-Value="formulario.CodigoBulto" />
                </label>
                <ValidationMessage For="() => formulario.CodigoBulto" />
                <label>Peso (g)
                    <InputNumber @bind-Value="formulario.PesoGramos" />
                </label>
                <ValidationMessage For="() => formulario.PesoGramos" />
                <label>Largo (cm)
                    <InputNumber @bind-Value="formulario.LargoCentimetros" />
                </label>
                <ValidationMessage For="() => formulario.LargoCentimetros" />
                <label>Ancho (cm)
                    <InputNumber @bind-Value="formulario.AnchoCentimetros" />
                </label>
                <ValidationMessage For="() => formulario.AnchoCentimetros" />
                <label>Alto (cm)
                    <InputNumber @bind-Value="formulario.AltoCentimetros" />
                </label>
                <ValidationMessage For="() => formulario.AltoCentimetros" />
                <button type="submit">@(enviando ? "Guardando…" : "Crear envío")</button>
            </fieldset>
        </EditForm>

@code {
    private readonly CancellationTokenSource cancelacion = new();
    private readonly CrearEnvioRequest formulario = new();
    private UsuarioActualResponse? usuarioActual;
    private IReadOnlyList<OperadorDisponibleResponse> operadores = [];
    private EnvioCreadoResponse? creado;
    private string? error;
    private bool enviando;
    private Guid accesoId;

    protected override async Task OnInitializedAsync()
    {
        var cancellationToken = cancelacion.Token;
        try
        {
            accesoId = SesionUsuario.ObtenerAccesoId((await AuthenticationState.GetAuthenticationStateAsync()).User);
            cancellationToken.ThrowIfCancellationRequested();
            usuarioActual = await UsuariosClient.ObtenerUsuarioActualAsync(accesoId, cancellationToken);
            operadores = await OperadoresClient.ListarOperadoresAsync(accesoId, cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (NexoRutaApiException exception) { error = exception.Message; }
        catch (HttpRequestException) { error = "No se pudo conectar con el servicio de envíos."; }
    }

    private async Task CrearAsync()
    {
        var cancellationToken = cancelacion.Token;
        enviando = true; error = null; creado = null;
        try
        {
            creado = await ApiClient.CrearEnvioAsync(formulario, accesoId, cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (NexoRutaApiException exception) { error = exception.Message; }
        catch (HttpRequestException) { error = "No se pudo guardar el envío porque el servicio no está disponible."; }
        finally { enviando = false; }
    }

    public void Dispose()
    {
        cancelacion.Cancel();
        cancelacion.Dispose();
    }
}
