@page "/envios/crear"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = ApiPermissionAuthorizationHandler.ShipmentsCreatePolicy)]

@using NexoRuta.Commerce.Components.Features.Envios.Shared
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization
@using System.ComponentModel.DataAnnotations
@using NexoRuta.ApiClient.Features.Envios.Contracts.Requests
@using NexoRuta.ApiClient.Features.Envios.Contracts.Responses
@using NexoRuta.ApiClient.Features.Operadores.Contracts.Responses
@using NexoRuta.ApiClient.Features.Usuarios.Contracts.Responses
@using NexoRuta.ApiClient.Core.Session
@using NexoRuta.ApiClient.Core.Exceptions
@using NexoRuta.ApiClient.Features.Envios.Clients
@using NexoRuta.ApiClient.Features.Operadores.Clients
@using NexoRuta.ApiClient.Features.IdentidadVisual
@using NexoRuta.ApiClient.Features.IdentidadVisual.Contracts.Responses
@using NexoRuta.ApiClient.Features.Usuarios.Clients
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject EnviosApiClient ApiClient
@inject UsuariosApiClient UsuariosClient
@inject OperadoresApiClient OperadoresClient
@inject AuthenticationStateProvider AuthenticationState
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Crear envío | NexoRuta</PageTitle>
<header class="nr-page-heading">
    <div><p class="nr-eyebrow">Envíos</p><h1>Crear envío</h1><p>Elegí el destino y revisá la tarifa antes de confirmar.</p></div>
    <div class="nr-page-actions"><a class="btn btn-outline-secondary" href="/envios">Mis envíos</a><a class="btn btn-outline-secondary" href="/envios/importar">Importar CSV</a></div>
</header>
@if (usuarioActual is not null)
{
    <p class="nr-admission-context">Enviás como <strong>@usuarioActual.ComercioNombre</strong>.</p>
}
@if (error is not null) { <p class="alert alert-danger" role="alert">@error</p> }
@if (usuarioActual is not null && operadores.Count == 0 && error is null)
{ <p class="alert alert-warning" role="status">Todavía no hay operadores registrados para crear un envío.</p> }
@if (usuarioActual is null && error is null)
{
    <div class="nr-detail-skeleton" aria-busy="true" aria-label="Cargando formulario"><p class="visually-hidden" role="status">Consultando tu comercio y operadores disponibles.</p><span aria-hidden="true"></span><span aria-hidden="true"></span></div>
}
@if (!formularioInteractivo)
{
    <p role="status">Conectando el formulario…</p>
}
<EditForm class="nr-form-stack nr-creation-form" EditContext="contextoEdicion" OnValidSubmit="CrearAsync" OnInvalidSubmit="EnfocarValidacionAsync" FormName="crear-envio" aria-busy="@((!formularioInteractivo).ToString().ToLowerInvariant())">
    <DataAnnotationsValidator />
    <div class="nr-validation-summary" tabindex="-1" @ref="resumenValidacion" aria-live="polite"><ValidationSummary /></div>
    <fieldset class="nr-creation-grid" disabled="@(!formularioInteractivo || enviando || cargandoIdentidad || usuarioActual is null || operadores.Count == 0 || creado is not null)">
        <section class="nr-form-section nr-admission-operator" aria-labelledby="alta-operador-titulo">
            <h2 id="alta-operador-titulo">Operador</h2>
            <div class="nr-field">
                <label for="envio-operador">Operador</label>
                <InputSelect id="envio-operador" @bind-Value="formulario.OperadorId" @bind-Value:after="CambiarOperadorAsync"><option value="">Seleccioná un operador</option>@foreach (var operador in operadores) { <option value="@operador.OperadorId">@operador.Nombre</option> }</InputSelect>
                <ValidationMessage For="() => formulario.OperadorId" />
            </div>
            @if (cargandoIdentidad) { <p role="status">Consultando operador…</p> }
            else if (errorIdentidad is not null) { <p class="alert alert-warning" role="alert">@errorIdentidad</p> }
            else if (identidad is not null)
            {
                <details class="nr-disclosure operator-identity-preview" style="--nr-operator-accent: @(ColorMarca.AcentoSobreBlanco(identidad.ColorPrimario) ?? "var(--nr-action)");">
                    <summary>Contacto de @identidad.Nombre</summary>
                    @if (identidad.LogoContenido is { Length: > 0 } && identidad.LogoTipoContenido is "image/png" or "image/jpeg") { <img class="operator-identity-logo" src="@LogoDataUri" alt="Logo de @identidad.Nombre" /> }
                    @if (identidad.CorreoPublico is not null) { <p>Correo: <a href="mailto:@identidad.CorreoPublico">@identidad.CorreoPublico</a></p> }
                    @if (identidad.TelefonoPublico is not null) { <p>Teléfono: <a href="tel:@TelefonoHref">@identidad.TelefonoPublico</a></p> }
                    @if (ColorMarca.TieneFormatoValido(identidad.ColorPrimario) || ColorMarca.TieneFormatoValido(identidad.ColorSecundario))
                    {
                        <ul class="operator-brand-colors" aria-label="Colores de marca del operador">
                            @if (ColorMarca.TieneFormatoValido(identidad.ColorPrimario)) { <li><span class="operator-brand-swatch" style="background-color:@identidad.ColorPrimario"></span>Primario</li> }
                            @if (ColorMarca.TieneFormatoValido(identidad.ColorSecundario)) { <li><span class="operator-brand-swatch" style="background-color:@identidad.ColorSecundario"></span>Secundario</li> }
                        </ul>
                    }
                </details>
            }
        </section>
        <section class="nr-form-section nr-admission-recipient" aria-labelledby="alta-destinatario-titulo">
            <h2 id="alta-destinatario-titulo">Destinatario</h2>
            <div class="nr-field"><label>Nombre<InputText @bind-Value="formulario.DestinatarioNombre" autocomplete="name" maxlength="160" /></label><ValidationMessage For="() => formulario.DestinatarioNombre" /></div>
            <div class="nr-field"><label>Correo del destinatario<InputText type="email" autocomplete="email" maxlength="254" @bind-Value="formulario.DestinatarioEmail" /></label><ValidationMessage For="() => formulario.DestinatarioEmail" /></div>
            <p class="form-text">Este correo permite verificar sus solicitudes de cancelación.</p>
        </section>
        <section class="nr-form-section nr-admission-destination" aria-labelledby="alta-destino-titulo">
            <h2 id="alta-destino-titulo">Destino y servicio</h2>
            <SelectorDestino OperadorId="formulario.OperadorId" ParaAlta="true" ApiToken="@token" Latitud="formulario.Servicio.Latitud" Longitud="formulario.Servicio.Longitud" Editable="true" Bloqueado="@(enviando || creado is not null)" PuntoCambiado="SeleccionarDestinoAsync" />
            <div class="nr-field"><label>Dirección<InputText @bind-Value="formulario.Direccion" maxlength="240" /></label><ValidationMessage For="() => formulario.Direccion" /></div>
            <details class="nr-disclosure"><summary>Ajustar coordenadas manualmente</summary><div class="nr-fields-grid">
                <label>Latitud<InputNumber @bind-Value="formulario.Servicio.Latitud" @bind-Value:after="PuntoManualAsync" min="-90" max="90" step="any" /></label>
                <label>Longitud<InputNumber @bind-Value="formulario.Servicio.Longitud" @bind-Value:after="PuntoManualAsync" min="-180" max="180" step="any" /></label>
            </div></details>
            @if (consultandoServicios) { <p role="status">Comprobando cobertura…</p> }
            @if (errorServicio is not null) { <p class="alert alert-warning" role="alert">@errorServicio</p> }
            @if (sinServicio)
            {
                <section class="nr-operator-alternatives" aria-labelledby="alternativas-titulo" aria-busy="@consultandoAlternativas.ToString().ToLowerInvariant()">
                    <h3 id="alternativas-titulo">Otros operadores llegan a este destino</h3>
                    @if (consultandoAlternativas) { <p role="status">Buscando otros operadores…</p> }
                    else if (errorAlternativas is not null)
                    {
                        <p role="alert">@errorAlternativas</p>
                        <button type="button" class="btn btn-outline-secondary" @onclick="ConsultarAlternativasAsync">Reintentar búsqueda</button>
                    }
                    else if (alternativasConsultadas && alternativas.Count == 0) { <p role="status">No hay otros operadores disponibles para este destino.</p> }
                    else if (alternativas.Count > 0)
                    {
                        <ul>
                            @foreach (var alternativa in alternativas.Take(mostrarTodasAlternativas ? alternativas.Count : 3))
                            {
                                <li><div><strong>@alternativa.Nombre</strong><span>@string.Join(" · ", alternativa.Modalidades.Select(x => x == "Estandar" ? "Estándar" : x))</span></div>
                                    <button type="button" class="btn btn-outline-primary" disabled="@(enviando || cotizando)" @onclick="() => ElegirAlternativaAsync(alternativa.OperadorId)" aria-label="Elegir operador @alternativa.Nombre">Elegir operador</button></li>
                            }
                        </ul>
                        @if (!mostrarTodasAlternativas && alternativas.Count > 3) { <button type="button" class="btn btn-link" @onclick="() => mostrarTodasAlternativas = true">Ver más</button> }
                    }
                </section>
            }
            <div class="nr-field"><label for="alta-servicio">Zona y modalidad</label><select id="alta-servicio" class="form-select" value="@servicioElegido" @onchange="ElegirServicioAsync" disabled="@(consultandoServicios || servicios.Count == 0)">
                <option value="">Seleccioná un servicio disponible</option>@foreach (var servicio in servicios) { <option value="@ClaveServicio(servicio)">@servicio.ZonaNombre · @(servicio.Modalidad == "Estandar" ? "Estándar" : servicio.Modalidad)</option> }
            </select><ValidationMessage For="() => formulario.Servicio.ZonaId" /></div>
            @if (formulario.OperadorId is not null && formulario.Servicio.Latitud is not null && formulario.Servicio.Longitud is not null)
            { <button type="button" class="btn btn-outline-secondary" disabled="@consultandoServicios" @onclick="ConsultarServiciosAsync">Volver a comprobar cobertura</button> }
        </section>
        <section class="nr-form-section nr-admission-packages" aria-labelledby="alta-bultos-titulo">
            <h2 id="alta-bultos-titulo">Bultos</h2>
            @foreach (var bulto in formulario.Bultos)
            {
                var numero = formulario.Bultos.IndexOf(bulto) + 1;
                <fieldset class="nr-parcel-card" @key="bulto"><legend>Bulto @numero</legend><div class="nr-parcel-fields">
                    <div class="nr-field nr-parcel-code"><label>Código<InputText @bind-Value="bulto.Codigo" maxlength="80" /></label><ValidationMessage For="() => bulto.Codigo" /></div>
                    <div class="nr-field"><label>Peso (g)<InputNumber @bind-Value="bulto.PesoGramos" min="0.01" max="999999999" step="0.01" /></label><ValidationMessage For="() => bulto.PesoGramos" /></div>
                    <div class="nr-field"><label>Largo (cm)<InputNumber @bind-Value="bulto.LargoCentimetros" min="0.01" max="999999999" step="0.01" /></label><ValidationMessage For="() => bulto.LargoCentimetros" /></div>
                    <div class="nr-field"><label>Ancho (cm)<InputNumber @bind-Value="bulto.AnchoCentimetros" min="0.01" max="999999999" step="0.01" /></label><ValidationMessage For="() => bulto.AnchoCentimetros" /></div>
                    <div class="nr-field"><label>Alto (cm)<InputNumber @bind-Value="bulto.AltoCentimetros" min="0.01" max="999999999" step="0.01" /></label><ValidationMessage For="() => bulto.AltoCentimetros" /></div>
                </div>@if (formulario.Bultos.Count > 1) { <button type="button" class="btn btn-outline-danger" @onclick="() => QuitarBulto(bulto)">Quitar bulto @numero</button> }</fieldset>
            }
            <button type="button" class="btn btn-outline-secondary" @onclick="AgregarBulto">Agregar bulto</button>
        </section>
        <section class="nr-admission-confirmation" aria-label="Revisión y confirmación">
            @if (cotizacion is not null)
            {
                <div class="nr-price-review" role="status" aria-live="polite">
                    <span>Tarifa para @formulario.Bultos.Count bultos &#183; @cotizacion.Modalidad</span>
                    <DesgloseTarifa Tarifa="cotizacion" />
                    <span>Se aplicar&#225; al confirmar el env&#237;o.</span>
                </div>
            }
            <button class="btn btn-primary" type="submit" disabled="@(enviando || cotizando || cargandoIdentidad || consultandoServicios || creado is not null)">@(cotizando ? "Cotizando…" : enviando ? "Procesando…" : cotizacion is null ? "Calcular tarifa" : "Confirmar envío")</button>
        </section>
    </fieldset>
</EditForm>

@code {
    private readonly CancellationTokenSource cancelacion = new();
    private readonly CrearEnvioRequest formulario = new() { Bultos = [new()] };
    private EditContext contextoEdicion = null!;
    private ElementReference resumenValidacion;
    private Task EnfocarValidacionAsync(EditContext _) => resumenValidacion.FocusAsync().AsTask();
    private TarifaEnvioResponse? cotizacion;
    private IReadOnlyList<ServicioEnvioDisponibleResponse> servicios = [];
    private string servicioElegido = "";
    private string? errorServicio;
    private bool consultandoServicios;
    private long consultaServicio;
    private CancellationTokenSource? serviciosCancelacion, alternativasCancelacion, cotizacionCancelacion;
    private long consultaAlternativas, consultaCotizacion;
    private IReadOnlyList<AlternativaOperadorEnvioResponse> alternativas = [];
    private bool sinServicio, consultandoAlternativas, alternativasConsultadas, mostrarTodasAlternativas, cotizarAlternativa, cotizando;
    private string? errorAlternativas;
    private UsuarioActualResponse? usuarioActual;
    private IReadOnlyList<OperadorDisponibleResponse> operadores = [];
    private EnvioCreadoResponse? creado;
    private string? error;
    private string? errorIdentidad;
    private IdentidadVisualPublicaResponse? identidad;
    private bool cargandoIdentidad;
    private int identidadSolicitud;
    private CancellationTokenSource? identidadCancelacion;
    private bool enviando;
    private bool formularioInteractivo;
    private string token = "";
    private string? LogoDataUri => identidad?.LogoContenido is { Length: > 0 } bytes && identidad.LogoTipoContenido is "image/png" or "image/jpeg"
        ? $"data:{identidad.LogoTipoContenido};base64,{Convert.ToBase64String(bytes)}" : null;
    private string TelefonoHref => identidad?.TelefonoPublico is { } value
        ? new string(value.Where(character => character is >= '0' and <= '9' || character == '+').ToArray()) : "";

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        formularioInteractivo = true;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        contextoEdicion = new EditContext(formulario);
        contextoEdicion.OnFieldChanged += CampoCambiado;
        var cancellationToken = cancelacion.Token;
        try
        {
            token = SesionUsuario.ObtenerToken((await AuthenticationState.GetAuthenticationStateAsync()).User);
            cancellationToken.ThrowIfCancellationRequested();
            usuarioActual = await UsuariosClient.ObtenerUsuarioActualAsync(token, cancellationToken);
            operadores = await OperadoresClient.ListarOperadoresAsync(token, cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (NexoRutaApiException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        { Navigation.NavigateTo("/ingresar?expirada=true", forceLoad: true); }
        catch (NexoRutaApiException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Forbidden)
        { error = "No tenés permiso para crear envíos."; }
        catch (NexoRutaApiException exception) { error = exception.Message; }
        catch (HttpRequestException) { error = "No se pudo conectar con el servicio de envíos."; }
    }

    private async Task CrearAsync()
    {
        if (enviando || cotizando || consultandoServicios || creado is not null) return;

        var cancellationToken = cancelacion.Token;
        enviando = true; error = null; creado = null;
        try
        {
            if (cotizacion is null)
                await CotizarAsync();
            else
            {
                creado = await ApiClient.CrearEnvioAsync(formulario, token, cancellationToken);
                Navigation.NavigateTo($"/envios/{creado.Id}?creado=true", forceLoad: true, replace: true);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (NexoRutaApiException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        { Navigation.NavigateTo("/ingresar?expirada=true", forceLoad: true); }
        catch (NexoRutaApiException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Forbidden)
        { error = "No tenés permiso para crear envíos."; }
        catch (NexoRutaApiException exception) when (exception.StatusCode == System.Net.HttpStatusCode.Conflict)
        { cotizacion = null; formulario.Servicio.VersionTarifarioEsperada = null; error = exception.Message; }
        catch (NexoRutaApiException exception) { InvalidarCotizacion(); error = exception.Message; }
        catch (HttpRequestException) { error = "No se pudo guardar el envío porque el servicio no está disponible."; }
        finally { enviando = false; }
    }

    private Task CambiarOperadorAsync() { cotizarAlternativa = false; return OperadorSeleccionadoAsync(); }

    private async Task OperadorSeleccionadoAsync()
    {
        var solicitud = Interlocked.Increment(ref identidadSolicitud);
        var anterior = identidadCancelacion;
        anterior?.Cancel();
        identidad = null; errorIdentidad = null;
        var serviciosPendientes = ConsultarServiciosAsync();
        if (formulario.OperadorId is not { } operatorId)
        {
            identidadCancelacion = null;
            cargandoIdentidad = false;
            await serviciosPendientes;
            return;
        }

        var carga = CancellationTokenSource.CreateLinkedTokenSource(cancelacion.Token);
        identidadCancelacion = carga;
        cargandoIdentidad = true;
        try
        {
            var resultado = await OperadoresClient.ObtenerIdentidadVisualAsync(operatorId, token, carga.Token);
            if (solicitud == identidadSolicitud && formulario.OperadorId == operatorId)
                identidad = resultado;
        }
        catch (OperationCanceledException) when (carga.IsCancellationRequested) { }
        catch (NexoRutaApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        { if (solicitud == identidadSolicitud) Navigation.NavigateTo("/ingresar?expirada=true", forceLoad: true); }
        catch (NexoRutaApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        { if (solicitud == identidadSolicitud) errorIdentidad = "El operador seleccionado ya no está disponible. Elegí otro."; }
        catch (NexoRutaApiException)
        { if (solicitud == identidadSolicitud) errorIdentidad = "No pudimos consultar la marca de este operador. Intentá nuevamente."; }
        catch (HttpRequestException)
        { if (solicitud == identidadSolicitud) errorIdentidad = "No pudimos consultar la marca de este operador. Intentá nuevamente."; }
        finally
        {
            if (solicitud == identidadSolicitud)
            {
                cargandoIdentidad = false;
                identidadCancelacion = null;
            }
            carga.Dispose();
        }
        await serviciosPendientes;
    }

    private void InvalidarCotizacion()
    {
        ++consultaCotizacion;
        var anterior = cotizacionCancelacion; cotizacionCancelacion = null; anterior?.Cancel(); cotizando = false;
        cotizacion = null; formulario.Servicio.VersionTarifarioEsperada = null; error = null;
    }
    private void CampoCambiado(object? sender, FieldChangedEventArgs args) => InvalidarCotizacion();
    private void AgregarBulto() { formulario.Bultos.Add(new()); InvalidarCotizacion(); }
    private void QuitarBulto(BultoDeclaradoRequest bulto) { formulario.Bultos.Remove(bulto); InvalidarCotizacion(); }
    private static string ClaveServicio(ServicioEnvioDisponibleResponse servicio) => $"{servicio.ZonaId:D}|{servicio.Modalidad}";
    private async Task ElegirServicioAsync(ChangeEventArgs args)
    {
        servicioElegido = args.Value?.ToString() ?? "";
        var elegido = servicios.SingleOrDefault(s => ClaveServicio(s) == servicioElegido);
        formulario.Servicio.ZonaId = elegido?.ZonaId;
        formulario.Servicio.Modalidad = elegido?.Modalidad ?? "Estandar";
        InvalidarCotizacion();
        if (cotizarAlternativa && elegido is not null && Validator.TryValidateObject(formulario, new ValidationContext(formulario), [], true))
            await CotizarAsync();
    }
    private async Task SeleccionarDestinoAsync((double? Latitud, double? Longitud, string? Descripcion) punto)
    {
        cotizarAlternativa = false;
        formulario.Servicio.Latitud = punto.Latitud; formulario.Servicio.Longitud = punto.Longitud;
        if (!string.IsNullOrWhiteSpace(punto.Descripcion)) formulario.Direccion = punto.Descripcion;
        await ConsultarServiciosAsync();
    }
    private Task PuntoManualAsync() { cotizarAlternativa = false; return ConsultarServiciosAsync(); }
    private async Task ConsultarServiciosAsync()
    {
        var consulta = ++consultaServicio;
        var anterior = serviciosCancelacion; serviciosCancelacion = null; anterior?.Cancel();
        LimpiarAlternativas(); InvalidarCotizacion();
        servicios = []; servicioElegido = ""; formulario.Servicio.ZonaId = null; errorServicio = null; consultandoServicios = false;
        if (formulario.OperadorId is not { } operador || formulario.Servicio.Latitud is not { } lat || formulario.Servicio.Longitud is not { } lon) return;
        var carga = CancellationTokenSource.CreateLinkedTokenSource(cancelacion.Token);
        serviciosCancelacion = carga; consultandoServicios = true;
        try
        {
            var resultado = await ApiClient.ServiciosAsync(operador, lat, lon, token, carga.Token);
            if (consulta != consultaServicio || carga.IsCancellationRequested || formulario.OperadorId != operador || formulario.Servicio.Latitud != lat || formulario.Servicio.Longitud != lon) return;
            servicios = resultado; consultandoServicios = false;
            if (servicios.Count == 0)
            {
                sinServicio = true;
                errorServicio = "El operador no ofrece cobertura y tarifa para este destino. Eleg\u00ed otro operador o revis\u00e1 el punto.";
                await ConsultarAlternativasAsync();
            }
            else if (servicios.Count == 1) await ElegirServicioAsync(new ChangeEventArgs { Value = ClaveServicio(servicios[0]) });
        }
        catch (OperationCanceledException) when (carga.IsCancellationRequested) { }
        catch (NexoRutaApiException exception)
        {
            if (consulta != consultaServicio || carga.IsCancellationRequested || formulario.OperadorId != operador || formulario.Servicio.Latitud != lat || formulario.Servicio.Longitud != lon) return;
            errorServicio = exception.Message;
            if (exception.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                sinServicio = true; consultandoServicios = false;
                await ConsultarAlternativasAsync();
            }
        }
        catch (HttpRequestException) { if (consulta == consultaServicio) errorServicio = "No pudimos comprobar cobertura. Conservamos los datos para que puedas reintentar."; }
        finally
        {
            if (consulta == consultaServicio) { consultandoServicios = false; serviciosCancelacion = null; }
            carga.Dispose();
        }
    }
    private void LimpiarAlternativas()
    {
        ++consultaAlternativas; alternativasCancelacion?.Cancel(); alternativasCancelacion = null;
        alternativas = []; sinServicio = alternativasConsultadas = consultandoAlternativas = mostrarTodasAlternativas = false; errorAlternativas = null;
    }
    private async Task ConsultarAlternativasAsync()
    {
        if (!sinServicio || formulario.OperadorId is not { } operador || formulario.Servicio.Latitud is not { } lat || formulario.Servicio.Longitud is not { } lon) return;
        var consulta = ++consultaAlternativas;
        alternativasCancelacion?.Cancel();
        var carga = CancellationTokenSource.CreateLinkedTokenSource(cancelacion.Token);
        alternativasCancelacion = carga; consultandoAlternativas = true; alternativasConsultadas = false; errorAlternativas = null; alternativas = [];
        if (formularioInteractivo) StateHasChanged();
        try
        {
            var resultado = await OperadoresClient.AlternativasEnvioAsync(lat, lon, operador, token, carga.Token);
            if (consulta != consultaAlternativas || carga.IsCancellationRequested || formulario.OperadorId != operador || formulario.Servicio.Latitud != lat || formulario.Servicio.Longitud != lon) return;
            alternativas = resultado; alternativasConsultadas = true;
        }
        catch (OperationCanceledException) when (carga.IsCancellationRequested) { }
        catch (HttpRequestException) { if (consulta == consultaAlternativas) errorAlternativas = "No pudimos buscar otros operadores. Reintent\u00e1 la consulta."; }
        finally
        {
            if (consulta == consultaAlternativas) { consultandoAlternativas = false; alternativasCancelacion = null; }
            carga.Dispose();
        }
    }
    private async Task ElegirAlternativaAsync(Guid operadorId)
    {
        if (enviando || cotizando) return;
        var alternativa = alternativas.SingleOrDefault(x => x.OperadorId == operadorId);
        if (alternativa is null || !sinServicio) return;
        if (!operadores.Any(x => x.OperadorId == operadorId)) operadores = operadores.Append(new OperadorDisponibleResponse(operadorId, alternativa.Nombre)).ToArray();
        cotizarAlternativa = true;
        formulario.OperadorId = operadorId;
        await OperadorSeleccionadoAsync();
    }
    private async Task CotizarAsync()
    {
        var consulta = ++consultaCotizacion;
        cotizacionCancelacion?.Cancel();
        var carga = CancellationTokenSource.CreateLinkedTokenSource(cancelacion.Token);
        cotizacionCancelacion = carga; cotizando = true; error = null;
        if (formularioInteractivo) StateHasChanged();
        try
        {
            formulario.Servicio.VersionTarifarioEsperada = null;
            var solicitud = System.Text.Json.JsonSerializer.Deserialize<CrearEnvioRequest>(System.Text.Json.JsonSerializer.Serialize(formulario))!;
            var resultado = await ApiClient.CotizarAsync(solicitud, token, carga.Token);
            if (consulta != consultaCotizacion || carga.IsCancellationRequested) return;
            cotizacion = resultado; formulario.Servicio.VersionTarifarioEsperada = resultado.VersionTarifarioId;
        }
        catch (OperationCanceledException) when (carga.IsCancellationRequested) { }
        catch (NexoRutaApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        { if (consulta == consultaCotizacion) Navigation.NavigateTo("/ingresar?expirada=true", forceLoad: true); }
        catch (NexoRutaApiException ex) { if (consulta == consultaCotizacion) error = ex.Message; }
        catch (HttpRequestException) { if (consulta == consultaCotizacion) error = "No pudimos calcular la tarifa. Conservamos los datos para reintentar."; }
        finally
        {
            if (consulta == consultaCotizacion) { cotizando = false; cotizacionCancelacion = null; }
            carga.Dispose();
        }
    }

    public void Dispose()
    {
        if (contextoEdicion is not null) contextoEdicion.OnFieldChanged -= CampoCambiado;
        Interlocked.Increment(ref identidadSolicitud);
        ++consultaServicio; ++consultaAlternativas; ++consultaCotizacion;
        identidadCancelacion?.Cancel();
        serviciosCancelacion?.Cancel(); alternativasCancelacion?.Cancel(); cotizacionCancelacion?.Cancel();
        cancelacion.Cancel();
        cancelacion.Dispose();
    }
}
