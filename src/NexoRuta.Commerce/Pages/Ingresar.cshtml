@page "/ingresar"
@model NexoRuta.Commerce.Features.Sesion.Pages.IngresarModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{ Layout = null; }
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ingresar | Portal de comercios NexoRuta</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <main class="container py-5" style="max-width: 480px">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <p class="text-muted mb-1">NexoRuta · Portal de comercios</p>
                <h1 class="h3 mb-3">Ingresar</h1>
                @if (Request.Query["registrado"] == "true") { <p class="alert alert-success" role="status">Cuenta creada. Ingresá para crear tu organización.</p> }
                <p><a href="/registrarse">¿No tenés cuenta? Registrate</a></p>
                @if (Model.Error is not null)
                {
                    <p class="alert alert-danger" role="alert">@Model.Error</p>
                }
                <form method="post" asp-page="/Ingresar" data-single-submit>
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <label asp-for="Email" class="form-label">Correo electrónico</label>
                    <input asp-for="Email" class="form-control mb-3" type="email" autocomplete="username" required maxlength="254" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                    <label asp-for="Password" class="form-label">Contraseña</label>
                    <input asp-for="Password" class="form-control mb-3" type="password" autocomplete="current-password" required />
                    <span asp-validation-for="Password" class="text-danger"></span>
                    <button type="submit" class="btn btn-primary w-100">Ingresar</button>
                </form>
                <p class="mt-3"><a href="/recuperar-contrasena">¿Olvidaste tu contraseña?</a></p>
                <p class="mt-3"><a href="/">Volver al inicio</a> · <a href="/#otros-accesos">Backoffice y Admin</a></p>
            </div>
        </div>
    </main>
    <script src="/js/site.js"></script>
</body>
</html>
