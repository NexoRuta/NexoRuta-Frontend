@page "/liquidaciones"
@model NexoRuta.Backoffice.Pages.Liquidaciones.IndexModel
@using NexoRuta.ApiClient.Features.Gestion
@{ViewData["Title"]="Liquidaciones y cuentas";}
<h1>Liquidaciones y cuentas</h1>
<p>Importes en UYU. Fechas en America/Montevideo (UTC−03). Los movimientos se incluyen por su fecha de registro: desde incluido, hasta excluido.</p>
<form method="get" class="row g-3 mb-4">
 <div class="col-lg-5"><label asp-for="ComercioId" class="form-label">Comercio (ID)</label><input asp-for="ComercioId" class="form-control" required /></div>
 <div class="col-sm-6 col-lg-3"><label asp-for="Desde" class="form-label">Desde</label><input asp-for="Desde" type="date" class="form-control" required /></div>
 <div class="col-sm-6 col-lg-3"><label asp-for="Hasta" class="form-label">Hasta (excluido)</label><input asp-for="Hasta" type="date" class="form-control" required /></div>
 <div><button type="submit" data-loading-text="Procesando…" class="btn btn-primary">Consultar cuenta</button> <a asp-page="/ReporteOperaciones">Elegir comercio desde reportes</a></div>
</form>
@if(Model.Error is not null){<p class="alert alert-danger" role="alert">@Model.Error</p>}
@if(Model.Cuenta is {} c){
 <h2>Cuenta del comercio</h2><p class="text-break">@c.ComercioId · Operador: @c.OperadorId</p>
 <dl><dt>Saldo operativo acumulado</dt><dd>@c.SaldoOperativoUyu.ToString("N2") UYU</dd><dt>Movimientos del período</dt><dd>@c.TotalPeriodoUyu.ToString("N2") UYU</dd><dt>Liquidable aún sin confirmar (todos los períodos)</dt><dd>@c.PendienteLiquidarUyu.ToString("N2") UYU</dd></dl>
 <p>Saldo = cargos y ajustes persistidos más correcciones compensatorias. Incluye cargos retenidos. Confirmar una liquidación documenta conceptos; no registra un pago ni reduce este saldo.</p>
 @if(Model.PuedeGestionar){<form method="post" asp-page-handler="Preparar" data-single-submit><input asp-for="Desde" type="hidden" /><input asp-for="Hasta" type="hidden" /><input asp-for="ComercioId" type="hidden" /><input asp-for="SolicitudId" type="hidden" /><button type="submit" data-loading-text="Procesando…" class="btn btn-primary">Preparar liquidación del período</button><span role="status" data-gestion-status></span></form>}
 else{<p>No tenés permiso para gestionar liquidaciones. Podés consultar la cuenta.</p>}
 <h3>Movimientos</h3><p>@c.Total movimientos en el período.</p>
 @if(c.Movimientos.Count==0){<p>No hay movimientos en este período.</p>}
 else{<div class="table-responsive" role="region" aria-label="Movimientos económicos" tabindex="0"><table class="table nr-economic-table"><thead><tr><th scope="col">Registro / operación</th><th scope="col">Concepto</th><th scope="col">Importe UYU</th><th scope="col">Tratamiento</th><th scope="col">Liquidación</th></tr></thead><tbody>
 @foreach(var m in c.Movimientos){<tr><td class="text-break">@PeriodoGestion.Fecha(m.FechaUtc)<br /><a href="/?Seleccion=@m.EnvioId">@m.EnvioId</a><br />Movimiento: @m.Id</td><td>@m.Concepto</td><td>@m.ImporteUyu.ToString("N2")</td><td>@m.Tratamiento</td><td class="text-break">@if(m.LiquidacionId is {} id){<a asp-page="/Liquidaciones/Index" asp-route-DocumentoId="@id" asp-route-ComercioId="@Model.ComercioId" asp-route-Desde="@Model.Desde.ToString("yyyy-MM-dd")" asp-route-Hasta="@Model.Hasta.ToString("yyyy-MM-dd")">@id</a>}</td></tr>}
 </tbody></table></div>}
 <h3>Documentos</h3>
 @if(c.Liquidaciones.Count==0){<p>No hay liquidaciones disponibles.</p>}
 else{<ul>@foreach(var l in c.Liquidaciones){<li class="text-break"><a asp-page="/Liquidaciones/Index" asp-route-DocumentoId="@l.Id" asp-route-ComercioId="@Model.ComercioId" asp-route-Desde="@Model.Desde.ToString("yyyy-MM-dd")" asp-route-Hasta="@Model.Hasta.ToString("yyyy-MM-dd")">@l.Id</a> · @l.Estado · @l.TotalUyu.ToString("N2") UYU</li>}</ul>}
 <nav aria-label="Páginas de cuenta">@if(Model.Pagina>1){<a class="btn btn-outline-secondary" asp-route-Pagina="@(Model.Pagina-1)" asp-route-ComercioId="@Model.ComercioId" asp-route-Desde="@Model.Desde.ToString("yyyy-MM-dd")" asp-route-Hasta="@Model.Hasta.ToString("yyyy-MM-dd")">Anterior</a>} @if(Model.Pagina*25<c.Total || c.Liquidaciones.Count==25){<a class="btn btn-outline-secondary" asp-route-Pagina="@(Model.Pagina+1)" asp-route-ComercioId="@Model.ComercioId" asp-route-Desde="@Model.Desde.ToString("yyyy-MM-dd")" asp-route-Hasta="@Model.Hasta.ToString("yyyy-MM-dd")">Siguiente</a>}</nav>
}
@if(Model.Documento is {} d){
 <section aria-labelledby="documento"><h2 id="documento" class="text-break">Liquidación @d.Documento.Id</h2>
 <p>@d.Documento.Estado · Período: @PeriodoGestion.Fecha(d.Documento.DesdeUtc) a @PeriodoGestion.Fecha(d.Documento.HastaUtc) (excluido). Corte: @PeriodoGestion.Fecha(d.Documento.CorteUtc).</p>
 <p class="text-break">Preparada por @d.Documento.PreparadaPor el @PeriodoGestion.Fecha(d.Documento.PreparadaEnUtc). @if(d.Documento.ConfirmadaPor is {} actor){<span>Confirmada por @actor el @PeriodoGestion.Fecha(d.Documento.ConfirmadaEnUtc).</span>}</p>
 <ol aria-label="Historial del documento">@foreach(var t in d.Transiciones){<li class="text-break">@t.Estado · @PeriodoGestion.Fecha(t.FechaUtc) · Actor: @t.ActorId</li>}</ol>
 <div class="table-responsive" role="region" aria-label="Conceptos de liquidación" tabindex="0"><table class="table nr-economic-table"><thead><tr><th scope="col">Movimiento / operación</th><th scope="col">Concepto</th><th scope="col">Importe UYU</th><th scope="col">Origen conservado</th></tr></thead><tbody>@foreach(var l in d.Lineas){<tr><td class="text-break">@l.MovimientoId<br />@l.EnvioId</td><td>@l.Concepto<br />@PeriodoGestion.Fecha(l.FechaUtc)</td><td>@l.ImporteUyu.ToString("N2")</td><td><details><summary>Ver cargo original</summary><pre class="nr-economic-source">@l.Fuente</pre></details></td></tr>}</tbody><tfoot><tr><th scope="row" colspan="2">Total</th><td>@d.Documento.TotalUyu.ToString("N2")</td><td>@d.Lineas.Count conceptos</td></tr></tfoot></table></div>
 @if(d.Documento.Estado=="Borrador" && Model.PuedeGestionar){<p>Revisá los conceptos. La confirmación es definitiva. Los cargos retenidos no se incluyen.</p><form method="post" asp-page-handler="Confirmar" data-single-submit><input asp-for="DocumentoId" type="hidden" /><input asp-for="ComercioId" type="hidden" /><input asp-for="Desde" type="hidden" /><input asp-for="Hasta" type="hidden" /><button type="submit" data-loading-text="Procesando…" class="btn btn-primary">Confirmar liquidación revisada</button><span role="status" data-gestion-status></span></form><form method="post" asp-page-handler="Descartar" data-single-submit class="mt-3"><input asp-for="DocumentoId" type="hidden" /><input asp-for="ComercioId" type="hidden" /><input asp-for="Desde" type="hidden" /><input asp-for="Hasta" type="hidden" /><button type="submit" data-loading-text="Procesando…" class="btn btn-outline-secondary">Descartar borrador</button></form>}
 @if(d.Documento.Estado=="Confirmada" && Model.PuedeGestionar){<details class="mt-3"><summary>Registrar corrección compensatoria</summary><p>El documento confirmado se conserva. Un importe negativo reduce el saldo; uno positivo agrega un débito. La corrección se liquidará en su fecha de registro.</p><form method="post" asp-page-handler="Corregir" data-single-submit class="row g-3"><input asp-for="DocumentoId" type="hidden" /><input asp-for="ComercioId" type="hidden" /><input asp-for="Desde" type="hidden" /><input asp-for="Hasta" type="hidden" /><input asp-for="SolicitudId" type="hidden" />
 <div class="col-lg-6"><label asp-for="MovimientoId" class="form-label">Movimiento confirmado</label><select asp-for="MovimientoId" class="form-select">@foreach(var l in d.Lineas){<option value="@l.MovimientoId">@l.Concepto · @l.ImporteUyu.ToString("N2") UYU · @l.MovimientoId</option>}</select></div>
 <div class="col-lg-3"><label asp-for="ImporteUyu" class="form-label">Importe UYU (con signo)</label><input asp-for="ImporteUyu" type="number" step="0.01" class="form-control" required /></div><div><label asp-for="Motivo" class="form-label">Motivo de la corrección</label><textarea asp-for="Motivo" minlength="10" maxlength="500" class="form-control" required></textarea></div><div><button type="submit" data-loading-text="Procesando…" class="btn btn-primary">Registrar movimiento compensatorio</button><span role="status" data-gestion-status></span></div></form></details>}
 </section>
}
