@page
@model NexoRuta.Backoffice.Features.Envios.Pages.IndexModel
@{
    ViewData["Title"] = "Envíos | Backoffice NexoRuta";
}

<h1>Envíos recibidos</h1>
@if (Model.Confirmacion is not null)
{
    <p class="alert alert-success" role="status">@Model.Confirmacion</p>
}
@if (Model.UsuarioActual is { } usuarioActual)
{
    <p>Operador: <strong>@usuarioActual.OperadorNombre</strong> · Usuario: @usuarioActual.UsuarioEmail</p>
}
@if (Model.Error is not null)
{
    <p class="alert alert-danger" role="alert">@Model.Error</p>
}
@if (Model.Envios.Count == 0 && Model.Error is null)
{
    <p>Este operador todavía no tiene envíos registrados. Los envíos de los comercios aparecerán aquí cuando se registren con este operador.</p>
}
else if (Model.Envios.Count > 0)
{
    <table class="table">
        <thead><tr><th>ID</th><th>Operador / comercio</th><th>Usuario</th><th>Destinatario</th><th>Dirección</th><th>Estado</th><th>Bultos</th>@if (Model.PuedeCancelar) { <th>Acciones</th> }</tr></thead>
        <tbody>
        @foreach (var envio in Model.Envios)
        {
            <tr>
                <td><code>@envio.Id</code></td>
                <td>@envio.OperadorNombre / @envio.ComercioNombre<br /><small>@envio.OperadorId / @envio.ComercioId</small></td>
                <td>@envio.UsuarioEmail<br /><small>@envio.CreadoPorUsuarioId</small></td>
                <td>@envio.DestinatarioNombre</td>
                <td>@envio.Direccion</td>
                <td>@envio.Estado</td>
                <td>
                    @foreach (var bulto in envio.Bultos)
                    {
                        <div>@bulto.Codigo — @bulto.PesoGramos g — @bulto.LargoCentimetros × @bulto.AnchoCentimetros × @bulto.AltoCentimetros cm</div>
                    }
                </td>
                @if (Model.PuedeCancelar)
                {
                    <td>
                    @if (envio.AdmiteCancelacion())
                    {
                        <details>
                            <summary>Cancelar envío</summary>
                            <form method="post" asp-page-handler="Cancelar">
                                <input type="hidden" name="EnvioId" value="@envio.Id" />
                                <input type="hidden" name="Version" value="@envio.Version" />
                                <label for="motivo-@envio.Id">Motivo de cancelación</label>
                                <textarea id="motivo-@envio.Id" name="Motivo" required maxlength="500" class="form-control"></textarea>
                                <p>Se suspenderá la entrega. Si el destinatario ya recibió el paquete, corresponde una devolución.</p>
                                <button type="submit" class="btn btn-danger">Confirmar cancelación</button>
                            </form>
                        </details>
                    }
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
}
