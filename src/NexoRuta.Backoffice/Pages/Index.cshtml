@page
@model IndexModel
@{
    ViewData["Title"] = "Envíos | Backoffice NexoRuta";
}

<h1>Envíos recibidos</h1>
<p>Vista de control del operador y comercio de demostración.</p>
@if (Model.Error is not null)
{
    <p class="alert alert-danger" role="alert">@Model.Error</p>
}
else if (Model.Envios.Count == 0)
{
    <p>No hay envíos registrados todavía. Creá uno desde el portal de comercio.</p>
}
else
{
    <table class="table">
        <thead><tr><th>ID</th><th>Operador / comercio</th><th>Usuario</th><th>Destinatario</th><th>Dirección</th><th>Estado</th><th>Bultos</th></tr></thead>
        <tbody>
        @foreach (var envio in Model.Envios)
        {
            <tr>
                <td><code>@envio.id</code></td>
                <td>@envio.operadorNombre / @envio.comercioNombre<br /><small>@envio.operadorId / @envio.operadorComercioId</small></td>
                <td>@envio.usuarioEmail<br /><small>@envio.creadoPorUsuarioId</small></td>
                <td>@envio.destinatarioNombre</td>
                <td>@envio.direccion</td>
                <td>@envio.estado</td>
                <td>
                    @foreach (var bulto in envio.bultos)
                    {
                        <div>@bulto.codigo — @bulto.pesoGramos g — @bulto.largoCentimetros × @bulto.anchoCentimetros × @bulto.altoCentimetros cm</div>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
