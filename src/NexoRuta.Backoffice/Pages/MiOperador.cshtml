@page "/mi-operador"
@model NexoRuta.Backoffice.Features.Organizaciones.Pages.MiOperadorModel
@{
    ViewData["Title"] = "Mi operador";
}

<h1>Mi operador</h1>
@if (Model.Error is not null)
{
    <p class="alert alert-danger" role="alert">@Model.Error</p>
}
@if (Model.Confirmacion is not null)
{
    <p class="alert alert-success" role="status">@Model.Confirmacion</p>
}
@if (Model.Organizacion is not null)
{
    <dl>
        <dt>Nombre</dt>
        <dd>@Model.Organizacion.Nombre</dd>
        <dt>Estado</dt>
        <dd>@Model.Organizacion.Estado</dd>
    </dl>
    @if (Model.Organizacion.EsPropietario)
    {
        <form method="post" asp-page-handler="Guardar" data-single-submit>
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <input type="hidden" asp-for="Version" />
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label">Nombre del operador</label>
                <input asp-for="Nombre" class="form-control" maxlength="160" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <button class="btn btn-primary" type="submit">Guardar cambios</button>
        </form>
    }
    else if (!Model.Organizacion.TieneDuenoRegistrado)
    {
        <p class="alert alert-warning" role="status">Este operador no tiene un dueño registrado. Podés consultar sus datos, pero la edición está deshabilitada hasta resolver su propiedad.</p>
    }
    else
    {
        <p class="text-secondary">Solo el dueño registrado puede editar los datos del operador.</p>
    }
}
@if (Model.Organizacion is { } organization)
{
    <section class="mt-5" aria-labelledby="baja-heading">
        <h2 id="baja-heading">Solicitud de baja</h2>
        <p>La solicitud requiere una resolución de plataforma. Mientras esté pendiente, el operador continúa activo. No se borran organizaciones, accesos, envíos ni historial.</p>
        @if (Model.Solicitudes.Any(x => x.Estado == "Pendiente"))
        {
            <p class="alert alert-info" role="status">Hay una solicitud pendiente. El operador sigue activo mientras plataforma la resuelve.</p>
        }
        @if (Model.Solicitudes.Count > 0)
        {
            <h3 class="h5">Historial de solicitudes</h3>
            <ul>@foreach (var request in Model.Solicitudes)
            { <li>@request.Estado · @request.SolicitadaEnUtc.ToLocalTime(): @request.Motivo @if (request.MotivoResolucion is not null) { <span>· Resolución: @request.MotivoResolucion</span> }</li> }</ul>
        }
        @if (organization.EsPropietario && organization.Estado == "Activa" && !Model.Solicitudes.Any(x => x.Estado == "Pendiente"))
        {
            <form method="post" asp-page-handler="SolicitarBaja" data-single-submit class="card p-3">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <label asp-for="MotivoBaja" class="form-label">Motivo</label>
                <textarea asp-for="MotivoBaja" class="form-control" maxlength="2000" required></textarea>
                <span asp-validation-for="MotivoBaja" class="text-danger"></span>
                <div class="form-check mt-3">
                    <input class="form-check-input" asp-for="ConfirmarBaja" required />
                    <label class="form-check-label" asp-for="ConfirmarBaja">Entiendo que la solicitud no suspende inmediatamente y requiere resolución de plataforma.</label>
                </div>
                <button class="btn btn-outline-danger mt-3" type="submit">Solicitar baja</button>
            </form>
        }
        else if (!organization.EsPropietario)
        {
            <p class="text-secondary">Solo el dueño registrado puede solicitar la baja.</p>
        }
    </section>
}
