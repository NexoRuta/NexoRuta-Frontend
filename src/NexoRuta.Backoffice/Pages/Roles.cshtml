@page "/roles"
@model NexoRuta.Backoffice.Features.Roles.Pages.IndexModel
@{
    ViewData["Title"] = "Roles y permisos | Backoffice NexoRuta";
}

<h1>Roles y permisos</h1>
<p>Los permisos disponibles son los definidos por la API; esta pantalla no crea ni elimina definiciones de permisos.</p>
@if (Model.Error is not null)
{
    <p class="alert alert-danger" role="alert">@Model.Error <a href="/roles">Recargar estado</a></p>
}
@if (Model.Confirmacion is not null)
{
    <p class="alert alert-success" role="status">@Model.Confirmacion</p>
}

<section aria-labelledby="alta-rol">
    <h2 id="alta-rol">Crear rol</h2>
    <form method="post" asp-page-handler="Crear" data-single-submit>
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="mb-3">
            <label asp-for="Codigo" class="form-label">Código</label>
            <input asp-for="Codigo" class="form-control" maxlength="80" />
            <span asp-validation-for="Codigo" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Nombre" class="form-label">Nombre</label>
            <input asp-for="Nombre" class="form-control" maxlength="160" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Crear rol</button>
    </form>
</section>

<section class="mt-5" aria-labelledby="catalogo-roles">
    <h2 id="catalogo-roles">Roles de la organización</h2>
    @if (Model.Roles.Count == 0 && Model.Error is null)
    {
        <p role="status">No hay roles configurados para esta organización.</p>
    }
    @if (Model.Permisos.Count == 0 && Model.Error is null)
    {
        <p role="status">El catálogo de permisos está vacío.</p>
    }
    @foreach (var rol in Model.Roles)
    {
        <article class="card mb-4">
            <div class="card-body">
                <h3 class="h5">@rol.Nombre <small class="text-muted">(@rol.Codigo)</small></h3>
                @if (rol.EsRolPropietario || rol.EsPropio || rol.EsProtegidoSistema)
                {
                    @if (rol.EsRolPropietario)
                    {
                        <p class="text-muted">Este rol está asignado al propietario de la organización; solo podés consultarlo.</p>
                    }
                    <p class="text-muted">Este rol es propio o está protegido por el sistema; solo podés consultarlo.</p>
                    <h4 class="h6">Permisos asignados</h4>
                    <ul>
                        @foreach (var permiso in rol.Permisos)
                        {
                            <li><code>@permiso</code></li>
                        }
                    </ul>
                }
                else
                {
                <form method="post" asp-page-handler="Renombrar" data-single-submit class="d-flex gap-2 mb-3">
                    <input type="hidden" name="id" value="@rol.Id" />
                    <label class="visually-hidden" for="nombre-@rol.Id">Nuevo nombre de @rol.Codigo</label>
                    <input id="nombre-@rol.Id" name="nombre" class="form-control" maxlength="160"
                           value="@(Model.RolEditadoId == rol.Id ? Model.NombreIntentado : rol.Nombre)" required />
                    <button type="submit" class="btn btn-outline-primary">Renombrar</button>
                </form>
                <form method="post" asp-page-handler="Permisos" data-single-submit>
                    <input type="hidden" name="id" value="@rol.Id" />
                    <fieldset>
                        <legend class="h6">Permisos asignados</legend>
                        @foreach (var permiso in Model.Permisos)
                        {
                            var asignado = Model.RolEditadoId == rol.Id && Model.PermisosIntentados is not null
                                ? Model.PermisosIntentados.Contains(permiso.Codigo, StringComparer.Ordinal)
                                : rol.Permisos.Contains(permiso.Codigo, StringComparer.Ordinal);
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="permisos" value="@permiso.Codigo"
                                       id="@rol.Id-@permiso.Id" checked="@(asignado ? "checked" : null)" />
                                <label class="form-check-label" for="@rol.Id-@permiso.Id">@permiso.Nombre <code>@permiso.Codigo</code></label>
                            </div>
                        }
                    </fieldset>
                    <button type="submit" class="btn btn-outline-primary mt-2">Guardar permisos</button>
                </form>
                <form method="post" asp-page-handler="Eliminar" data-single-submit class="mt-3">
                    <input type="hidden" name="id" value="@rol.Id" />
                    <button type="submit" class="btn btn-outline-danger">Eliminar rol</button>
                </form>
                }
            </div>
        </article>
    }
</section>
