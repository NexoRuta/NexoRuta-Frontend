@page "/OrganizacionSuspendida"
@model NexoRuta.Backoffice.Features.Sesion.Pages.OrganizacionSuspendidaModel
@{ ViewData["Title"] = "Organización suspendida"; }
<header class="nr-page-header"><div><h1>Organización suspendida</h1><p>Estado y solicitudes vinculadas a este operador.</p></div></header>
@if (Model.Error is not null) { <p class="alert alert-warning" role="alert">@Model.Error</p> }
@if (Model.Estado is { } estado)
{
    <p class="alert alert-danger" role="status">@estado.Nombre (@estado.TipoOrganizacion) está suspendida.</p>
    <p>@estado.Mensaje</p>
}
<p>Las cuentas y los envíos históricos se conservan. Después de la reactivación, ingresá nuevamente para obtener una sesión vigente.</p>
@if (Model.Confirmacion is not null) { <p class="alert alert-success" role="status">@Model.Confirmacion</p> }
<section class="nr-content-section" aria-labelledby="reactivacion-heading">
<h2 id="reactivacion-heading">Solicitudes de reactivación</h2>
@if (Model.Solicitudes.Count == 0) { <p>Aún no hay solicitudes.</p> }
else
{
    <ul>@foreach (var solicitud in Model.Solicitudes)
    { <li>@solicitud.Estado · @solicitud.SolicitadaEnUtc.ToLocalTime(): @solicitud.Motivo
        @if (solicitud.MotivoResolucion is not null) { <span>· Resolución: @solicitud.MotivoResolucion</span> }
    </li> }</ul>
}
@if (Model.Estado is { EsPropietario: true } && !Model.Solicitudes.Any(x => x.Estado == "Pendiente"))
{
    <form method="post" data-single-submit class="card p-3 mb-3 nr-form-stack">
        <p>Solicitar la reactivación no activa el operador inmediatamente. Plataforma debe resolver la solicitud.</p>
        <label asp-for="Motivo" class="form-label">Motivo</label>
        <textarea asp-for="Motivo" class="form-control" maxlength="2000" required></textarea>
        <span asp-validation-for="Motivo" class="text-danger"></span>
        <label class="mt-3"><input asp-for="Confirmar" type="checkbox" required /> Confirmo que deseo solicitar la reactivación.</label>
        <span asp-validation-for="Confirmar" class="text-danger"></span>
        <button type="submit" class="btn btn-primary mt-3">Solicitar reactivación</button>
    </form>
}
else if (Model.Estado is { EsPropietario: false }) { <p>Solo el dueño registrado puede solicitar la reactivación.</p> }
<form method="post" asp-page="/Salir" data-single-submit><button type="submit" class="btn btn-outline-secondary">Cerrar sesión</button></form>
</section>
