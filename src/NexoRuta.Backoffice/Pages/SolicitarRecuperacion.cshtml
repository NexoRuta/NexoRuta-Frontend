@page "/recuperar-contrasena"
@model NexoRuta.Backoffice.Features.Sesion.Pages.SolicitarRecuperacionModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{ Layout = null; }
<!doctype html>
<html lang="es">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Recuperar contraseña | Backoffice</title></head>
<body>
<main>
    <h1>Recuperá tu contraseña</h1>
    <p>Ingresá el correo registrado. Si pertenece a una cuenta, vas a recibir instrucciones para restablecer la contraseña.</p>
    @if (Model.SolicitudEnviada) { <p role="status">Si el correo pertenece a una cuenta, vas a recibir instrucciones para restablecer la contraseña.</p> }
    @if (Model.Error is not null) { <p role="alert">@Model.Error</p> }
    <form method="post" asp-page="/SolicitarRecuperacion" data-single-submit>
        <label asp-for="Email">Correo electrónico</label>
        <input asp-for="Email" type="email" autocomplete="email" required maxlength="254" />
        <span asp-validation-for="Email" role="alert"></span>
        <button type="submit">Enviar instrucciones</button>
    </form>
    <p><a href="/ingresar">Volver a ingresar</a></p>
</main>
</body>
</html>
