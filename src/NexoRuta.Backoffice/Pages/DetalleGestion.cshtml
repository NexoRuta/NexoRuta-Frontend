@page "/reportes/operaciones/{id:guid}"
@model NexoRuta.Backoffice.Pages.DetalleGestionModel
@using NexoRuta.ApiClient.Features.Gestion
@{ViewData["Title"]="Detalle de indicador";}
<h1>Detalle de indicador</h1><p><a href="@Model.Volver">Volver a los filtros del reporte</a></p>
@if(Model.Error is not null){<p class="alert alert-danger" role="alert">@Model.Error</p>}
@if(Model.Detalle is {} d){
 <p class="text-break">Operación: @d.Operacion.EnvioId · @d.Operacion.Estado · @d.Operacion.Cumplimiento</p>
 <p>Zona capturada: @d.Operacion.Zona. Compromiso: @PeriodoGestion.Fecha(d.Operacion.CompromisoHastaUtc). Finalización física: @PeriodoGestion.Fecha(d.Operacion.CompletadaEnUtc). America/Montevideo (UTC−03).</p>
 <p>La atribución se obtiene del diario de la entrega física o retiro. No depende del repartidor asignado actualmente. Las visitas posteriores que completan evidencia no vuelven a contar como entrega.</p>
 <div class="table-responsive" role="region" aria-label="Resultados históricos por bulto" tabindex="0"><table class="table"><thead><tr><th scope="col">Bulto</th><th scope="col">Resultado</th><th scope="col">Fecha física</th><th scope="col">Repartidor histórico</th><th scope="col">Ruta histórica</th><th scope="col">Franja capturada</th></tr></thead><tbody>@foreach(var b in d.Bultos){<tr><td class="text-break">@b.BultoId</td><td>@b.Resultado</td><td>@PeriodoGestion.Fecha(b.EntregadoEnUtc)</td><td class="text-break">@(b.RepartidorId?.ToString()??"Sin autor verificable")</td><td class="text-break">@(b.RutaId?.ToString()??"Sin ruta verificable")</td><td>@(b.EnFranja is true?"Dentro":b.EnFranja is false?"Fuera":"Sin dato suficiente")</td></tr>}</tbody></table></div>
 <p><a href="/?Seleccion=@d.Operacion.EnvioId">Abrir operación</a></p>
}
