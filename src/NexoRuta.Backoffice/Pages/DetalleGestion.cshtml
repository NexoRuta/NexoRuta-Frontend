@page "/reportes/operaciones/{id:guid}"
@model NexoRuta.Backoffice.Pages.DetalleGestionModel
@using NexoRuta.ApiClient.Features.Gestion
@{ViewData["Title"]="Detalle de indicador";}
<h1>Detalle de indicador</h1><p><a class="btn btn-outline-secondary" href="@Model.Volver">Volver a los filtros del reporte</a></p>
@if(Model.Error is not null){<p class="alert alert-danger" role="alert">@Model.Error</p>}
@if(Model.Detalle is {} d){
 <p class="text-break">Operación: @Model.Referencias.Nombre("Envio",d.Operacion.EnvioId) · @EtiquetasGestion.Texto(d.Operacion.Estado) · @EtiquetasGestion.Texto(d.Operacion.Cumplimiento)</p>
 <p>Zona: @if(Guid.TryParse(d.Operacion.Zona,out var zona)){<span>@Model.Referencias.Nombre("Zona",zona) (nombre actual).</span>}else{<span>@d.Operacion.Zona (capturada).</span>} Compromiso: @PeriodoGestion.Fecha(d.Operacion.CompromisoHastaUtc). Finalización física: @PeriodoGestion.Fecha(d.Operacion.CompletadaEnUtc). America/Montevideo (UTC−03).</p>
 <details class="mb-3"><summary>Cómo se atribuye la entrega</summary><p>La atribución se obtiene del diario de la entrega física o retiro. No depende del repartidor asignado actualmente. Las visitas posteriores que completan evidencia no vuelven a contar como entrega.</p></details>
 <div class="table-responsive" role="region" aria-label="Resultados históricos por bulto" tabindex="0"><table class="table nr-report-table"><thead><tr><th scope="col">Bulto</th><th scope="col">Resultado</th><th scope="col">Fecha física</th><th scope="col">Autor · nombre actual</th><th scope="col">Ruta histórica</th><th scope="col">Franja capturada</th></tr></thead><tbody>@foreach(var b in d.Bultos){<tr><td class="text-break">@Model.Referencias.Nombre("Bulto",b.BultoId)<details><summary>Identificador</summary>@b.BultoId</details></td><td>@EtiquetasGestion.Texto(b.Resultado)</td><td>@PeriodoGestion.Fecha(b.EntregadoEnUtc)</td><td class="text-break">@Model.Referencias.Nombre("Repartidor",b.RepartidorId)</td><td class="text-break">@(b.RutaId is {} ruta ? Model.Referencias.Nombre("Ruta",ruta) : "Sin ruta verificable")<details><summary>Referencia técnica</summary>@b.RutaId</details></td><td>@(b.EnFranja is true?"Dentro":b.EnFranja is false?"Fuera":"Sin dato suficiente")</td></tr>}</tbody></table></div>
 <p><a class="btn btn-outline-secondary" href="/?Seleccion=@d.Operacion.EnvioId">Abrir operación</a></p>
}
