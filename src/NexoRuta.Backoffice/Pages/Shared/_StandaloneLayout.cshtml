@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NexoRuta</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/portal-design.css" asp-append-version="true" />
</head>
<body class="nr-auth-shell nr-backoffice-standalone">
    <a class="nr-skip-link" href="#main-content">Saltar al contenido principal</a>
    <header class="nr-auth-header">
        <a class="nr-brand" href="/ingresar" aria-label="NexoRuta, portal Backoffice">
            <span class="nr-brand-mark" aria-hidden="true">N</span>
            <span>NexoRuta <small>Backoffice</small></span>
        </a>
    </header>
    <main class="nr-auth-main" id="main-content" tabindex="-1">@RenderBody()</main>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
