<!DOCTYPE html>
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NexoRuta.Backoffice</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/portal-design.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NexoRuta.Backoffice.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
@{
    var mostrarNavegacion = User.Identity?.IsAuthenticated == true
        && !User.HasClaim(NexoRuta.ApiClient.Core.Session.SesionUsuario.ClaimTipoAcceso, NexoRuta.ApiClient.Core.Session.SesionUsuario.OrganizacionSuspendida);
    var navigation = mostrarNavegacion
        ? await NexoRuta.Backoffice.Core.Navigation.BackofficeNavigation.LoadAsync(AuthorizationService, User, Context)
        : NexoRuta.Backoffice.Core.Navigation.BackofficeNavigationSnapshot.Hidden;
}
<body>
    <a class="nr-skip-link" href="#main-content">Saltar al contenido principal</a>
    <div class="nr-app-shell nr-backoffice-shell" id="backoffice-app-shell">
        <header class="nr-topbar">
            <a class="nr-brand" asp-area="" asp-page="/Index" aria-label="NexoRuta Backoffice, inicio">
                <span class="nr-brand-mark" aria-hidden="true">N</span>
                <span>NexoRuta <small>Backoffice</small></span>
            </a>
            <div class="nr-topbar-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form method="post" asp-page="/Salir" data-single-submit>
                        <button type="submit" class="btn btn-outline-secondary">Cerrar sesión</button>
                    </form>
                }
                <button class="navbar-toggler nr-menu-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#backofficeNavigation" aria-controls="backofficeNavigation" aria-expanded="false" aria-label="Mostrar u ocultar navegación principal">
                    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                </button>
            </div>
        </header>
        <div class="nr-portal-layout @(mostrarNavegacion ? "has-sidebar" : null)">
            @if (mostrarNavegacion)
            {
            <aside id="backofficeNavigation" class="nr-sidebar collapse d-lg-block">
                <partial name="Shared/_BackofficeNavigation" model="navigation" />
            </aside>
            }
            <div class="nr-main-column">
                <main id="main-content" role="main" class="nr-main-content" tabindex="-1">
                    <div class="nr-page nr-page-backoffice">
                        @RenderBody()
                    </div>
                </main>
                <footer class="nr-footer">NexoRuta <span aria-hidden="true">·</span> Backoffice</footer>
            </div>
        </div>
    </div>

    @await RenderSectionAsync("PageDialogs", required: false)

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
