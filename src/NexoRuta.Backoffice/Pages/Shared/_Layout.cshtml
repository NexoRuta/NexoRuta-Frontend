<!DOCTYPE html>
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NexoRuta.Backoffice</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NexoRuta.Backoffice.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
@{
    var permisos = Context.Items.TryGetValue(NexoRuta.Backoffice.Core.Security.ApiPermissionAuthorizationHandler.PermissionsCacheKey, out var granted)
        ? granted as IReadOnlyList<string> ?? []
        : [];
    var puedeGestionarZonas = false;
    if (User.Identity?.IsAuthenticated == true && !User.HasClaim(NexoRuta.ApiClient.Core.Session.SesionUsuario.ClaimTipoAcceso, NexoRuta.ApiClient.Core.Session.SesionUsuario.OrganizacionSuspendida))
    {
        var operadorActual = await AuthorizationService.AuthorizeAsync(User, null, NexoRuta.ApiClient.Core.Session.SesionUsuario.Operador);
        if (operadorActual.Succeeded)
        {
            var permisoZonas = await AuthorizationService.AuthorizeAsync(User, null, NexoRuta.Backoffice.Features.ZonasCobertura.ZonaCoberturaUi.PermisoGestionar);
            puedeGestionarZonas = permisoZonas.Succeeded;
        }
    }
}
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">NexoRuta.Backoffice</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (!User.HasClaim(NexoRuta.ApiClient.Core.Session.SesionUsuario.ClaimTipoAcceso, NexoRuta.ApiClient.Core.Session.SesionUsuario.OrganizacionSuspendida))
                        {
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/MiOperador">Mi operador</a></li>
                        @if (permisos.Contains("envios.consultar", StringComparer.Ordinal))
                        {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Envíos</a>
                        </li>
                        }
                        @if (permisos.Contains("envios.gestionar", StringComparer.Ordinal))
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Rutas">Rutas y depósito</a></li>
                        }
                        @if (permisos.Contains("usuarios.gestionar", StringComparer.Ordinal))
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Usuarios">Usuarios</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Repartidores">Repartidores</a></li>
                        }
                        @if (permisos.Contains(NexoRuta.Backoffice.Features.ZonasCobertura.ZonaCoberturaUi.PermisoGestionar, StringComparer.Ordinal))
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/ConfiguracionReparto">Configuración de reparto</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Roles">Roles y permisos</a></li>
                        }
                        @if (puedeGestionarZonas)
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/ZonasCobertura/Index">Zonas y franjas</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Tarifas/Index">Tarifas</a></li>
                        }
                        }
                    </ul>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form method="post" asp-page="/Salir" data-single-submit>
                            <button type="submit" class="btn btn-link">Cerrar sesión</button>
                        </form>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
