@page "/vehiculos"
@model NexoRuta.Backoffice.Features.Reparto.Pages.VehiculosModel
@{ ViewData["Title"] = "Vehículos"; }
<header class="nr-page-header"><div><h1>Vehículos</h1><p>Matrículas, capacidades y habilitación para nuevos despachos. Deshabilitar no libera ocupación ni impide resolver un retorno o cierre existente.</p><a href="/configuracion-reparto#perfiles-heading">Configurar compatibilidad vial</a></div></header>
@if (Model.Error is not null) { <div class="alert alert-danger" role="alert">@Model.Error</div> }
@if (Model.Confirmacion is not null) { <div class="alert alert-success" role="status">@Model.Confirmacion</div> }
@if (Model.GuardadoBloqueadoPorCarga) { <p class="alert alert-warning" role="status">No se intentó guardar porque no pudimos consultar los vehículos. Los valores y la versión enviados se conservan.</p> }
@if (!Model.CargaCompleta && !Model.MostrarVehiculoEnviado) { <form method="get" asp-page-handler="Reintentar"><button class="btn btn-outline-primary" type="submit">Reintentar consulta</button></form> }
@if (Model.CargaCompleta || Model.MostrarVehiculoEnviado)
{
<section class="nr-content-section" aria-labelledby="vehiculos-heading">
<h2 id="vehiculos-heading">Listado y gestión</h2>
<form method="post" asp-page-handler="Vehiculo" class="card card-body mb-3 nr-form-stack" aria-labelledby="vehiculo-formulario-heading" data-single-submit>
    <h3 id="vehiculo-formulario-heading" class="h5">@(Model.Vehiculo.Id == Guid.Empty ? "Agregar vehículo" : "Editar vehículo")</h3>
    <input type="hidden" asp-for="Vehiculo.Id" /><input type="hidden" asp-for="Vehiculo.Version" />
    <label asp-for="Vehiculo.Matricula">Matrícula</label><input asp-for="Vehiculo.Matricula" class="form-control mb-2" required maxlength="20" aria-describedby="matricula-error" aria-invalid="@((ViewData.ModelState["Vehiculo.Matricula"]?.Errors.Count ?? 0) > 0 ? "true" : null)" /><span asp-validation-for="Vehiculo.Matricula" id="matricula-error" class="text-danger"></span>
    <label asp-for="Vehiculo.PesoMaximoGramos">Capacidad de peso (gramos)</label><input asp-for="Vehiculo.PesoMaximoGramos" type="number" step="0.01" min="0.01" max="9999999999999999" class="form-control mb-2" required aria-describedby="peso-error" aria-invalid="@((ViewData.ModelState["Vehiculo.PesoMaximoGramos"]?.Errors.Count ?? 0) > 0 ? "true" : null)" /><span asp-validation-for="Vehiculo.PesoMaximoGramos" id="peso-error" class="text-danger"></span>
    <label asp-for="Vehiculo.VolumenMaximoCm3">Capacidad de volumen (cm³)</label><input asp-for="Vehiculo.VolumenMaximoCm3" type="number" step="0.01" min="0.01" max="9999999999999999999999" class="form-control mb-2" required aria-describedby="volumen-error" aria-invalid="@((ViewData.ModelState["Vehiculo.VolumenMaximoCm3"]?.Errors.Count ?? 0) > 0 ? "true" : null)" /><span asp-validation-for="Vehiculo.VolumenMaximoCm3" id="volumen-error" class="text-danger"></span>
    <label class="mb-3"><input asp-for="Vehiculo.Activo" /> Activo</label>
    <button class="btn btn-primary align-self-start">@(Model.CargaCompleta ? (Model.Vehiculo.Id == Guid.Empty ? "Agregar vehículo" : "Guardar vehículo") : "Reintentar guardado")</button>
</form>
@if (Model.CargaCompleta)
{
@if (Model.Vehiculos.Count == 0) { <p>No hay vehículos registrados.</p> }
@foreach (var item in Model.Vehiculos)
{
    <form method="post" asp-page-handler="Vehiculo" class="card card-body mb-2" aria-label="Editar vehículo @item.Matricula" data-single-submit>
        <input type="hidden" name="Vehiculo.Id" value="@item.Id" /><input type="hidden" name="Vehiculo.Version" value="@item.Version" />
        <div class="row g-2">
            <div class="col-md-3"><label for="matricula-@item.Id">Matrícula</label><input id="matricula-@item.Id" name="Vehiculo.Matricula" value="@item.Matricula" class="form-control" required maxlength="20" /></div>
            <div class="col-md-3"><label for="peso-@item.Id">Peso (g)</label><input id="peso-@item.Id" name="Vehiculo.PesoMaximoGramos" value="@item.PesoMaximoGramos.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" step="0.01" min="0.01" max="9999999999999999" class="form-control" required /></div>
            <div class="col-md-3"><label for="volumen-@item.Id">Volumen (cm³)</label><input id="volumen-@item.Id" name="Vehiculo.VolumenMaximoCm3" value="@item.VolumenMaximoCm3.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" step="0.01" min="0.01" max="9999999999999999999999" class="form-control" required /></div>
            <div class="col-md-3 align-self-end"><label><input type="checkbox" name="Vehiculo.Activo" value="true" checked="@item.Activo" /> Activo</label><input type="hidden" name="Vehiculo.Activo" value="false" /><button class="btn btn-outline-primary">Guardar</button></div>
        </div>
    </form>
}
}
</section>
}

