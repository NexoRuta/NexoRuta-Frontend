@page "/zonas/crear"
@model NexoRuta.Backoffice.Features.ZonasCobertura.Pages.CrearModel
@using NexoRuta.Backoffice.Features.ZonasCobertura
@{
    ViewData["Title"] = "Crear zona | Backoffice NexoRuta";
}
@section Head {
    <link rel="stylesheet" href="~/css/zonas-cobertura.css" asp-append-version="true" />
    @if (Model.MapboxConfigured)
    {
        <link href="https://api.mapbox.com/mapbox-gl-js/v@(ZonaCoberturaUi.MapboxGlJsVersion)/mapbox-gl.css" rel="stylesheet" />
        <link href="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-draw/v@(ZonaCoberturaUi.MapboxDrawVersion)/mapbox-gl-draw.css" rel="stylesheet" />
    }
}

<header class="nr-page-header"><div><h1>Crear zona de cobertura</h1></div><a class="btn btn-outline-secondary" asp-page="/ZonasCobertura/Index">Volver a zonas</a></header>
<p>La zona se crea inactiva. Podés agregar franjas y activarla después.</p>
@if (Model.Error is not null) { <p class="alert alert-danger" role="alert">@Model.Error</p> }

<form method="post" data-single-submit>
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label">Nombre de la zona</label>
        <input asp-for="Nombre" class="form-control" maxlength="120" required />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <fieldset class="mb-3">
        <legend class="fs-5">Fuente de geometría (elegí una)</legend>
        <div class="form-check">
            <input asp-for="Fuente" class="form-check-input" type="radio" value="@ZonaCoberturaUi.FuenteDibujo" id="source-drawing" checked="@(Model.Fuente == ZonaCoberturaUi.FuenteDibujo ? "checked" : null)" disabled="@(!Model.MapboxConfigured || !Model.CatalogoConsultado || Model.CatalogoVacio)" />
            <label class="form-check-label" for="source-drawing">Dibujo propio en el mapa</label>
        </div>
        @if (!Model.MapboxConfigured)
        {
            <p class="form-text">El dibujo no está disponible porque falta configurar un token público de Mapbox.</p>
        }
        <div class="form-check">
            <input asp-for="Fuente" class="form-check-input" type="radio" value="@ZonaCoberturaUi.FuenteDepartamento" id="source-department" disabled="@(!Model.CatalogoConsultado || Model.CatalogoVacio)" />
            <label class="form-check-label" for="source-department">Copiar un departamento del catálogo local</label>
        </div>
        @if (!Model.CatalogoConsultado)
        {
            <p class="form-text" role="status">No se pudo consultar el catálogo departamental. Revisá la disponibilidad de la API; no se asumió que el catálogo estuviera vacío.</p>
        }
        else if (Model.CatalogoVacio)
        {
            <p class="form-text" role="status">Las referencias departamentales todavía no están cargadas. No se puede crear una zona hasta disponer del catálogo territorial local.</p>
        }
        else if (!Model.MapboxConfigured) { <p class="form-text" role="status">El catálogo está disponible, pero Mapbox no está configurado para mostrar o dibujar geometrías.</p> }
    </fieldset>

    <div id="department-source" class="mb-3" hidden>
        <label asp-for="CodigoDepartamento" class="form-label">Departamento</label>
        <select asp-for="CodigoDepartamento" class="form-select" disabled="@(!Model.CatalogoConsultado || Model.CatalogoVacio)">
            <option value="">Seleccioná un departamento</option>
            @foreach (var departamento in Model.Departamentos)
            {
                <option value="@departamento.Codigo">@departamento.Nombre (@departamento.Codigo)</option>
            }
        </select>
        <p class="form-text">Se copiará la geometría de la referencia local; la zona resultante será propia e independiente.</p>
    </div>

    <div id="drawing-source" class="mb-3">
        <p class="form-text">Dibujá una cobertura dentro del contorno de Uruguay. La API valida la geometría completa al guardar; no se moverán ni recortarán vértices.</p>
    </div>
    @if (Model.MapboxConfigured)
    {
        <div id="coverage-map" class="coverage-map" role="application" aria-label="Mapa de Uruguay para seleccionar o dibujar una zona"
             data-mode="create" data-token="@Model.MapboxPublicToken" data-style="@Model.MapboxStyleUrl"
             data-editable="true" data-geometry="@Model.GeometriaJson" data-geometry-input="GeometriaJson"
             data-territory-url="@Url.Page("/ZonasCobertura/Crear", "Territorio")"
             data-department-url="@Url.Page("/ZonasCobertura/Crear", "Departamento")"></div>
        <p id="map-status" class="form-text" role="status" aria-live="polite">Cargando referencia territorial…</p>
    }
    else
    {
        <p class="alert alert-warning" role="status">Mapbox no está configurado. No se puede ver ni dibujar una geometría; el catálogo aún puede ofrecer la creación por departamento.</p>
    }
    <input asp-for="GeometriaJson" type="hidden" />

    <button type="submit" class="btn btn-primary" disabled="@(!Model.CatalogoConsultado || Model.CatalogoVacio)">Crear zona inactiva</button>
    <a class="btn btn-outline-secondary" asp-page="/ZonasCobertura/Index">Cancelar</a>
</form>

@section Scripts {
    @if (Model.MapboxConfigured)
    {
        <script src="https://api.mapbox.com/mapbox-gl-js/v@(ZonaCoberturaUi.MapboxGlJsVersion)/mapbox-gl.js"></script>
        <script src="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-draw/v@(ZonaCoberturaUi.MapboxDrawVersion)/mapbox-gl-draw.js"></script>
    }
    <script src="~/js/zonas-cobertura.js" asp-append-version="true"></script>
}
