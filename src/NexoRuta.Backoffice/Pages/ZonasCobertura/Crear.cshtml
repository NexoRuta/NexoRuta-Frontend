@page "/zonas/crear"
@model NexoRuta.Backoffice.Features.ZonasCobertura.Pages.CrearModel
@using NexoRuta.Backoffice.Features.ZonasCobertura
@{
    ViewData["Title"] = "Crear zona | Backoffice NexoRuta";
}
@section Head {
    <link rel="stylesheet" href="~/css/zonas-cobertura.css" asp-append-version="true" />
    @if (Model.MapboxConfigured)
    {
        <link href="https://api.mapbox.com/mapbox-gl-js/v@(ZonaCoberturaUi.MapboxGlJsVersion)/mapbox-gl.css" rel="stylesheet" />
        <link href="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-draw/v@(ZonaCoberturaUi.MapboxDrawVersion)/mapbox-gl-draw.css" rel="stylesheet" />
    }
}

<header class="nr-page-header"><div><h1>Crear zona de cobertura</h1></div><a class="btn btn-outline-secondary" asp-page="/ZonasCobertura/Index">Volver a zonas</a></header>
<p>La zona se crea inactiva. Podés agregar franjas y activarla después.</p>
@if (Model.Error is not null) { <p class="alert alert-danger" role="alert">@Model.Error</p> }

<form id="zone-form" method="post" data-single-submit data-selected-department="@Model.CodigoDepartamento"
      data-department-asset-url="@Url.Content("~/data/departamentos-uruguay.geojson")">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label">Nombre de la zona</label>
        <input asp-for="Nombre" class="form-control" maxlength="120" required />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <fieldset class="mb-3">
        <legend class="fs-5">Fuente de geometría (elegí una)</legend>
        <div class="form-check">
            <input asp-for="Fuente" class="form-check-input" type="radio" value="@ZonaCoberturaUi.FuenteDibujo" id="source-drawing" checked="@(Model.Fuente == ZonaCoberturaUi.FuenteDibujo ? "checked" : null)" disabled="@(!Model.MapboxConfigured)" />
            <label class="form-check-label" for="source-drawing">Dibujo propio en el mapa</label>
        </div>
        @if (!Model.MapboxConfigured)
        {
            <p class="form-text">El dibujo no está disponible porque falta configurar un token público de Mapbox.</p>
        }
        <div class="form-check">
            <input asp-for="Fuente" class="form-check-input" type="radio" value="@ZonaCoberturaUi.FuenteDepartamento" id="source-department" disabled="disabled" />
            <label class="form-check-label" for="source-department">Copiar un departamento oficial</label>
        </div>
        <p id="department-reference-status" class="form-text" role="status" aria-live="polite">Cargando límites departamentales oficiales…</p>
        <button type="button" id="retry-department-reference" class="btn btn-outline-secondary btn-sm mb-3" hidden>
            Reintentar límites departamentales
        </button>
    </fieldset>

    <div id="department-source" class="mb-3" hidden>
        <label asp-for="CodigoDepartamento" class="form-label">Departamento</label>
        <select asp-for="CodigoDepartamento" class="form-select" disabled="disabled">
            <option value="">Seleccioná un departamento</option>
        </select>
        <p class="form-text">Se guardará una copia independiente de la geometría con su código y versión oficial.</p>
    </div>

    <div id="drawing-source" class="mb-3">
        <p class="form-text">Dibujá una cobertura dentro del contorno de Uruguay. La API valida la geometría completa al guardar; no se moverán ni recortarán vértices.</p>
    </div>
    @if (Model.MapboxConfigured)
    {
        <div id="coverage-map" class="coverage-map" role="application" aria-label="Mapa de Uruguay para seleccionar o dibujar una zona"
             data-mode="create" data-token="@Model.MapboxPublicToken" data-style="@Model.MapboxStyleUrl"
             data-department-asset-url="@Url.Content("~/data/departamentos-uruguay.geojson")"
             data-mapbox-script-url="https://api.mapbox.com/mapbox-gl-js/v@(ZonaCoberturaUi.MapboxGlJsVersion)/mapbox-gl.js"
             data-draw-script-url="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-draw/v@(ZonaCoberturaUi.MapboxDrawVersion)/mapbox-gl-draw.js"
             data-mapbox-style-url="https://api.mapbox.com/mapbox-gl-js/v@(ZonaCoberturaUi.MapboxGlJsVersion)/mapbox-gl.css"
             data-draw-style-url="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-draw/v@(ZonaCoberturaUi.MapboxDrawVersion)/mapbox-gl-draw.css"
             data-editable="true" data-geometry="@Model.GeometriaJson" data-geometry-input="GeometriaJson"></div>
        <p id="map-status" class="form-text" role="status" aria-live="polite">Cargando Mapbox…</p>
        <button type="button" id="retry-map" class="btn btn-outline-secondary btn-sm mb-3" hidden>Reintentar mapa</button>
    }
    else
    {
        <p class="alert alert-warning" role="status">Mapbox no está configurado. Podés copiar un departamento oficial o dibujar cuando se configure un token público.</p>
    }
    <input asp-for="GeometriaJson" type="hidden" />

    <button type="submit" id="create-zone-submit" class="btn btn-primary" disabled>Crear zona inactiva</button>
    <a class="btn btn-outline-secondary" asp-page="/ZonasCobertura/Index">Cancelar</a>
</form>

@section Scripts {
    @if (Model.MapboxConfigured)
    {
        <script src="https://api.mapbox.com/mapbox-gl-js/v@(ZonaCoberturaUi.MapboxGlJsVersion)/mapbox-gl.js"></script>
        <script src="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-draw/v@(ZonaCoberturaUi.MapboxDrawVersion)/mapbox-gl-draw.js"></script>
    }
    <script src="~/js/zonas-cobertura.js" asp-append-version="true"></script>
}
