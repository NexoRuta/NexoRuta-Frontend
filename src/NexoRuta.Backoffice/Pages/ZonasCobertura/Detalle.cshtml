@page "/zonas/{zonaId:guid}"
@model NexoRuta.Backoffice.Features.ZonasCobertura.Pages.DetalleModel
@using NexoRuta.Backoffice.Features.ZonasCobertura
@using System.Globalization
@{
    ViewData["Title"] = Model.Zona is null ? "Zona | Backoffice NexoRuta" : $"{Model.Zona.Nombre} | Backoffice NexoRuta";
}
@section Head {
    <link rel="stylesheet" href="~/css/zonas-cobertura.css" asp-append-version="true" />
    @if (Model.MapboxConfigured)
    {
        <link href="https://api.mapbox.com/mapbox-gl-js/v@(ZonaCoberturaUi.MapboxGlJsVersion)/mapbox-gl.css" rel="stylesheet" />
        <link href="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-draw/v@(ZonaCoberturaUi.MapboxDrawVersion)/mapbox-gl-draw.css" rel="stylesheet" />
    }
}

<p><a asp-page="/ZonasCobertura/Index">← Volver a zonas</a></p>
@if (Model.Error is not null)
{
    <p class="alert @(Model.Conflicto ? "alert-warning" : "alert-danger")" role="alert">
        @Model.Error
        @if (Model.Zona is not null) { <a asp-page="/ZonasCobertura/Detalle" asp-route-zonaId="@Model.Zona.Id">Recargar estado actual</a> }
        else { <a asp-page="/ZonasCobertura/Index">Volver al listado</a> }
    </p>
}
@if (Model.Confirmacion is not null) { <p class="alert alert-success" role="status">@Model.Confirmacion</p> }

@if (Model.Zona is { } zona)
{
    <header class="nr-page-header">
        <div>
            <h1>@zona.Nombre</h1>
            <p>Estado: <strong>@zona.Estado</strong> · Zona horaria: <strong>@zona.ZonaHoraria</strong></p>
            <p>Versión del agregado: <strong>@zona.Version</strong> · Revisión vigente: <strong>@zona.RevisionActual</strong></p>
            <p>Geometría: @zona.OrigenGeometria
                @if (zona.CodigoDepartamento is not null) { <span>· Departamento @zona.CodigoDepartamento · referencia @zona.VersionFuente</span> }
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-start">
            <a class="btn btn-outline-secondary" asp-page="/ZonasCobertura/Index">Volver a zonas</a>
            @if (zona.Estado == ZonaCoberturaUi.EstadoActiva)
            {
                <form method="post" asp-page-handler="Estado" data-single-submit>
                    <input type="hidden" name="estado" value="@ZonaCoberturaUi.EstadoInactiva" />
                    <input type="hidden" name="version" value="@zona.Version" />
                    <button class="btn btn-outline-danger" type="submit" disabled="@Model.Conflicto">Desactivar zona</button>
                </form>
            }
            else
            {
                var activeSlots = zona.Franjas.Count(x => x.Estado == ZonaCoberturaUi.EstadoActiva);
                <form method="post" asp-page-handler="Estado" data-single-submit>
                    <input type="hidden" name="estado" value="@ZonaCoberturaUi.EstadoActiva" />
                    <input type="hidden" name="version" value="@zona.Version" />
                    <button class="btn btn-outline-success" type="submit" disabled="@(Model.Conflicto || activeSlots == 0)">Activar zona</button>
                </form>
                @if (activeSlots == 0) { <p class="form-text">Agregá al menos una franja activa para habilitar la zona.</p> }
            }
        </div>
    </header>

    <section aria-labelledby="geometry-title" class="mb-4">
        <h2 id="geometry-title">Cobertura geográfica</h2>
        @if (Model.MapboxConfigured)
        {
            <p class="form-text">
                @if (Model.GeometriaEditable)
                {
                    <span>Esta geometría tiene un componente y un anillo exterior. Podés editar sus vértices sin perder partes ni huecos.</span>
                }
                else
                {
                    <span>Esta geometría tiene varios componentes o anillos; se muestra en modo lectura para no descartar partes.</span>
                }
                Seleccioná un punto en el mapa para consultar la cobertura del operador.
            </p>
            @if (Model.GeometriaEditable && !Model.Conflicto)
            {
                <button type="button" id="edit-vertices" class="btn btn-sm btn-outline-primary mb-2">Editar vértices</button>
            }
            <div id="coverage-map" class="coverage-map" role="application" aria-label="Mapa de la zona y consulta de cobertura"
                 data-mode="detail" data-token="@Model.MapboxPublicToken" data-style="@Model.MapboxStyleUrl"
                 data-editable="@(Model.GeometriaEditable && !Model.Conflicto ? "true" : "false")"
                 data-geometry="@Model.GeometriaJson" data-geometry-input="GeometriaJson"
                 data-territory-url="@Url.Page("/ZonasCobertura/Detalle", "Territorio", new { zonaId = zona.Id })"
                 data-longitude-input="Longitud" data-latitude-input="Latitud"
                 data-coverage-longitude="@Model.Longitud" data-coverage-latitude="@Model.Latitud"></div>
            <p id="map-status" class="form-text" role="status" aria-live="polite">Cargando referencia territorial…</p>
        }
        else
        {
            <p class="alert alert-warning" role="status">Mapbox no está configurado. Podés editar otros campos; la geometría se conservará sin cambios y no se simulará una edición.</p>
        }
    </section>

    <section aria-labelledby="edit-zone-title" class="mb-5">
        <h2 id="edit-zone-title">Editar zona</h2>
        <form method="post" asp-page-handler="Editar" data-single-submit>
            <input asp-for="VersionEditada" type="hidden" />
            <input asp-for="GeometriaJson" type="hidden" />
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label">Nombre</label>
                <input asp-for="Nombre" class="form-control" maxlength="120" required disabled="@Model.Conflicto" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary" disabled="@Model.Conflicto">Guardar cambios</button>
            <p class="form-text">Cada cambio crea una revisión nueva. Un conflicto requiere revisar y recargar la configuración actual.</p>
        </form>
    </section>

    <section aria-labelledby="slots-title" class="mb-5">
        <h2 id="slots-title">Franjas semanales</h2>
        <p>Zona horaria: @zona.ZonaHoraria. El inicio está incluido y el final excluido; franjas contiguas están permitidas. Un horario igual no representa 24 horas.</p>
        @if (zona.Franjas.Count == 0) { <p role="status">Todavía no hay franjas configuradas.</p> }
        else
        {
        <div class="table-responsive" role="region" aria-label="Franjas de la zona; desplazamiento horizontal disponible en pantallas pequeñas" tabindex="0"><table class="table align-middle">
                <thead><tr><th>Día</th><th>Inicio</th><th>Fin</th><th>Estado</th><th>Editar</th></tr></thead>
                <tbody>
                @foreach (var franja in zona.Franjas)
                {
                    var postedEdit = Model.FranjaEditadaConError == franja.Id;
                    var startHourSelection = postedEdit ? Model.HoraInicioHora : ZonaCoberturaUi.HourPart(franja.HoraInicio);
                    var startMinuteSelection = postedEdit ? Model.HoraInicioMinuto : ZonaCoberturaUi.MinutePart(franja.HoraInicio);
                    var endHourSelection = postedEdit ? Model.HoraFinHora : ZonaCoberturaUi.HourPart(franja.HoraFin);
                    var endMinuteSelection = postedEdit ? Model.HoraFinMinuto : ZonaCoberturaUi.MinutePart(franja.HoraFin);
                    var startForGuidance = ZonaCoberturaUi.ComposeTime(startHourSelection, startMinuteSelection, franja.HoraInicio);
                    var endForGuidance = ZonaCoberturaUi.ComposeTime(endHourSelection, endMinuteSelection, franja.HoraFin);
                    <tr>
                        <td>@ZonaCoberturaUi.DayName(franja.DiaSemanaIso)</td>
                        <td><code>@franja.HoraInicio</code></td>
                        <td><code>@franja.HoraFin</code> @if (ZonaCoberturaUi.IsOvernight(franja)) { <span class="badge text-bg-info">Termina al día siguiente</span> }</td>
                        <td>@franja.Estado</td>
                        <td>
                            <form method="post" asp-page-handler="EditarFranja" data-single-submit data-slot-time-form class="slot-time-editor">
                                <input type="hidden" name="VersionZona" value="@zona.Version" />
                                <div class="slot-day-field">
                                <label class="form-label" for="day-@franja.Id">Día (ISO 1–7)</label>
                                <select id="day-@franja.Id" name="DiaSemanaIso" class="form-select" required disabled="@Model.Conflicto">
                                    @for (short day = 1; day <= 7; day++)
                                    {
                                        <option value="@day" selected="@((postedEdit ? Model.DiaSemanaIso == day : franja.DiaSemanaIso == day) ? "selected" : null)">@ZonaCoberturaUi.DayName(day)</option>
                                    }
                                </select>
                                </div>
                                <fieldset class="slot-time-group">
                                    <legend class="h6">Inicio</legend>
                                    <div class="slot-time-controls">
                                        <div><label class="form-label" for="start-hour-@franja.Id">Hora</label>
                                            <select id="start-hour-@franja.Id" name="HoraInicioHora" class="form-select" data-time-part="start-hour" data-original-time="@franja.HoraInicio" required disabled="@Model.Conflicto">
                                                <option value="" selected="@(startHourSelection is null ? "selected" : null)">Elegir</option>
                                                @for (var hour = 0; hour < 24; hour++) { var value = hour.ToString("00", CultureInfo.InvariantCulture); <option value="@value" selected="@(startHourSelection == value ? "selected" : null)">@value</option> }
                                            </select>
                                        </div>
                                        <div><label class="form-label" for="start-minute-@franja.Id">Minuto</label>
                                            <select id="start-minute-@franja.Id" name="HoraInicioMinuto" class="form-select" data-time-part="start-minute" required disabled="@Model.Conflicto">
                                                <option value="" selected="@(startMinuteSelection is null ? "selected" : null)">Elegir</option>
                                                @for (var minute = 0; minute < 60; minute++) { var value = minute.ToString("00", CultureInfo.InvariantCulture); <option value="@value" selected="@(startMinuteSelection == value ? "selected" : null)">@value</option> }
                                            </select>
                                        </div>
                                    </div>
                                </fieldset>
                                <fieldset class="slot-time-group">
                                    <legend class="h6">Fin</legend>
                                    <div class="slot-time-controls">
                                        <div><label class="form-label" for="end-hour-@franja.Id">Hora</label>
                                            <select id="end-hour-@franja.Id" name="HoraFinHora" class="form-select" data-time-part="end-hour" data-original-time="@franja.HoraFin" required disabled="@Model.Conflicto">
                                                <option value="" selected="@(endHourSelection is null ? "selected" : null)">Elegir</option>
                                                @for (var hour = 0; hour < 24; hour++) { var value = hour.ToString("00", CultureInfo.InvariantCulture); <option value="@value" selected="@(endHourSelection == value ? "selected" : null)">@value</option> }
                                            </select>
                                        </div>
                                        <div><label class="form-label" for="end-minute-@franja.Id">Minuto</label>
                                            <select id="end-minute-@franja.Id" name="HoraFinMinuto" class="form-select" data-time-part="end-minute" required disabled="@Model.Conflicto">
                                                <option value="" selected="@(endMinuteSelection is null ? "selected" : null)">Elegir</option>
                                                @for (var minute = 0; minute < 60; minute++) { var value = minute.ToString("00", CultureInfo.InvariantCulture); <option value="@value" selected="@(endMinuteSelection == value ? "selected" : null)">@value</option> }
                                            </select>
                                        </div>
                                    </div>
                                </fieldset>
                                <span class="slot-time-guidance form-text" data-slot-time-guidance aria-live="polite">@ZonaCoberturaUi.TimeGuidance(startForGuidance, endForGuidance)</span>
                                <label class="visually-hidden" for="status-@franja.Id">Estado de la franja</label>
                                <select id="status-@franja.Id" name="EstadoFranja" class="form-select form-select-sm" disabled="@Model.Conflicto">
                                    <option value="@ZonaCoberturaUi.EstadoActiva" selected="@((postedEdit ? Model.EstadoFranja == ZonaCoberturaUi.EstadoActiva : franja.Estado == ZonaCoberturaUi.EstadoActiva) ? "selected" : null)">Activa</option>
                                    <option value="@ZonaCoberturaUi.EstadoInactiva" selected="@((postedEdit ? Model.EstadoFranja == ZonaCoberturaUi.EstadoInactiva : franja.Estado == ZonaCoberturaUi.EstadoInactiva) ? "selected" : null)">Inactiva</option>
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-primary" disabled="@Model.Conflicto">Guardar franja</button>
                                <input type="hidden" name="franjaId" value="@franja.Id" />
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table></div>
        }

        <h3>Agregar franja</h3>
        <form id="new-slot-form" method="post" asp-page-handler="CrearFranja" data-single-submit data-slot-time-form class="slot-time-editor slot-time-create">
            <input type="hidden" name="VersionZona" value="@zona.Version" />
            <div class="slot-day-field">
                <label for="new-day" class="form-label">Día (ISO 1–7)</label>
                <select id="new-day" name="DiaSemanaIso" class="form-select" required disabled="@Model.Conflicto">
                    <option value="">Elegir</option>
                    @for (short day = 1; day <= 7; day++) { <option value="@day" selected="@(Model.AltaFranjaConError && Model.DiaSemanaIso == day ? "selected" : null)">@ZonaCoberturaUi.DayName(day)</option> }
                </select>
            </div>
            <fieldset class="slot-time-group">
                <legend class="h6">Inicio</legend>
                <div class="slot-time-controls">
                    <div><label class="form-label" for="new-start-hour">Hora</label>
                        <select id="new-start-hour" name="HoraInicioHora" class="form-select" data-time-part="start-hour" required disabled="@Model.Conflicto">
                            <option value="" selected="@(!Model.AltaFranjaConError || Model.HoraInicioHora is null ? "selected" : null)">Elegir</option>
                            @for (var hour = 0; hour < 24; hour++) { var value = hour.ToString("00", CultureInfo.InvariantCulture); <option value="@value" selected="@(Model.AltaFranjaConError && Model.HoraInicioHora == value ? "selected" : null)">@value</option> }
                        </select>
                    </div>
                    <div><label class="form-label" for="new-start-minute">Minuto</label>
                        <select id="new-start-minute" name="HoraInicioMinuto" class="form-select" data-time-part="start-minute" required disabled="@Model.Conflicto">
                            <option value="" selected="@(!Model.AltaFranjaConError || Model.HoraInicioMinuto is null ? "selected" : null)">Elegir</option>
                            @for (var minute = 0; minute < 60; minute++) { var value = minute.ToString("00", CultureInfo.InvariantCulture); <option value="@value" selected="@(Model.AltaFranjaConError && Model.HoraInicioMinuto == value ? "selected" : null)">@value</option> }
                        </select>
                    </div>
                </div>
            </fieldset>
            <fieldset class="slot-time-group">
                <legend class="h6">Fin</legend>
                <div class="slot-time-controls">
                    <div><label class="form-label" for="new-end-hour">Hora</label>
                        <select id="new-end-hour" name="HoraFinHora" class="form-select" data-time-part="end-hour" required disabled="@Model.Conflicto">
                            <option value="" selected="@(!Model.AltaFranjaConError || Model.HoraFinHora is null ? "selected" : null)">Elegir</option>
                            @for (var hour = 0; hour < 24; hour++) { var value = hour.ToString("00", CultureInfo.InvariantCulture); <option value="@value" selected="@(Model.AltaFranjaConError && Model.HoraFinHora == value ? "selected" : null)">@value</option> }
                        </select>
                    </div>
                    <div><label class="form-label" for="new-end-minute">Minuto</label>
                        <select id="new-end-minute" name="HoraFinMinuto" class="form-select" data-time-part="end-minute" required disabled="@Model.Conflicto">
                            <option value="" selected="@(!Model.AltaFranjaConError || Model.HoraFinMinuto is null ? "selected" : null)">Elegir</option>
                            @for (var minute = 0; minute < 60; minute++) { var value = minute.ToString("00", CultureInfo.InvariantCulture); <option value="@value" selected="@(Model.AltaFranjaConError && Model.HoraFinMinuto == value ? "selected" : null)">@value</option> }
                        </select>
                    </div>
                </div>
            </fieldset>
            <span class="slot-time-guidance form-text" data-slot-time-guidance aria-live="polite">@ZonaCoberturaUi.TimeGuidance(ZonaCoberturaUi.ComposeTime(Model.HoraInicioHora, Model.HoraInicioMinuto), ZonaCoberturaUi.ComposeTime(Model.HoraFinHora, Model.HoraFinMinuto))</span>
            <button type="submit" class="btn btn-outline-primary align-self-end" disabled="@Model.Conflicto">Agregar franja activa</button>
        </form>
        <p class="form-text">Las horas nuevas usan segundos y fracciones en cero. Si el fin es anterior al inicio, termina al día siguiente; domingo–lunes también se valida como una semana continua. No dejes una zona activa sin franjas activas.</p>
    </section>

    <section aria-labelledby="coverage-title" class="mb-5">
        <h2 id="coverage-title">Consultar cobertura por un punto</h2>
        @if (!Model.MapboxConfigured)
        {
            <p>La selección visual requiere configurar Mapbox. No se consultó ni guardó ningún punto.</p>
        }
        else
        {
            <form method="post" asp-page-handler="ConsultarCobertura" data-single-submit>
                <input asp-for="Longitud" type="hidden" />
                <input asp-for="Latitud" type="hidden" />
                <p id="selected-point" role="status" aria-live="polite">Seleccioná un punto en el mapa.</p>
                <button id="query-coverage" type="submit" class="btn btn-outline-primary" disabled="@(string.IsNullOrWhiteSpace(Model.Longitud) || string.IsNullOrWhiteSpace(Model.Latitud))">Consultar punto seleccionado</button>
            </form>
            @if (Model.Cobertura is { } coverage)
            {
                if (coverage.Resultado == ZonaCoberturaUi.ResultadoSinCobertura)
                {
                    <p class="alert alert-info mt-3" role="status">Sin cobertura para este punto en el operador actual.</p>
                }
                else if (coverage.Resultado == ZonaCoberturaUi.ResultadoCubierta)
                {
                    @if (coverage.RequiereSeleccionDeZona) { <p class="alert alert-info mt-3">El punto coincide con varias zonas. Revisá todas; no se seleccionó una automáticamente.</p> }
                    else { <p class="alert alert-success mt-3">El punto coincide con una zona.</p> }
                    @foreach (var match in coverage.Coincidencias)
                    {
                        <article class="card card-body mb-2">
                            <h3 class="h5">@match.Nombre · revisión @match.RevisionActual</h3>
                            @if (match.FranjasActivas.Count == 0) { <p>No hay franjas activas.</p> }
                            else
                            {
                                <ul class="mb-0">@foreach (var slot in match.FranjasActivas)
                                { <li>@ZonaCoberturaUi.DayName(slot.DiaSemanaIso): @slot.HoraInicio–@slot.HoraFin @if (ZonaCoberturaUi.IsOvernight(slot)) { <span>(termina al día siguiente)</span> }</li> }</ul>
                            }
                        </article>
                    }
                }
                else { <p class="alert alert-warning" role="status">La API devolvió un resultado de cobertura no reconocido.</p> }
            }
        }
    </section>
}

@section Scripts {
    @if (Model.MapboxConfigured)
    {
        <script src="https://api.mapbox.com/mapbox-gl-js/v@(ZonaCoberturaUi.MapboxGlJsVersion)/mapbox-gl.js"></script>
        <script src="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-draw/v@(ZonaCoberturaUi.MapboxDrawVersion)/mapbox-gl-draw.js"></script>
    }
    <script src="~/js/zonas-cobertura.js" asp-append-version="true"></script>
}
