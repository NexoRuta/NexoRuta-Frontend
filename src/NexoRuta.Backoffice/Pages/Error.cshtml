@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<section class="nr-page-state">
    <header class="nr-page-heading">
        <div>
            <p class="nr-eyebrow">NO SE PUDO COMPLETAR</p>
            <h1>No pudimos cargar esta pantalla</h1>
            <p>Intentá nuevamente. Si el problema continúa, compartí el identificador con soporte.</p>
        </div>
    </header>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Identificador de consulta:</strong> <code>@Model.RequestId</code>
    </p>
}
    <a class="btn btn-primary" asp-page="/Index">Volver a envíos</a>
</section>
