@page "/configuracion-reparto"
@model NexoRuta.Backoffice.Features.Reparto.Pages.ConfiguracionRepartoModel
@{ ViewData["Title"] = "Configuración de reparto"; }
<header class="nr-page-header"><div><h1>Configuración de reparto</h1><p>Configurá el reparto antes de despachar la primera ruta. Los intentos, motivos y pruebas se publican en <a href="/reglas-operativas">Reglas operativas</a> y se fijan al crear cada envío. Cada hoja conserva la versión con la que fue despachada.</p></div></header>
@if (Model.Error is not null) { <div class="alert alert-danger" role="alert">@Model.Error</div> }
@if (Model.Confirmacion is not null) { <div class="alert alert-success" role="status">@Model.Confirmacion</div> }
@if (Model.GuardadoBloqueadoPorCarga)
{
    <p class="alert alert-warning" role="status">No se intentó guardar porque no pudimos cargar la configuración. Los valores enviados siguen en el formulario; reintentá cuando el servicio esté disponible.</p>
}
@if (!Model.CargaCompleta && !Model.MostrarPoliticaEnviada)
{
    <form method="get" asp-page-handler="Reintentar">
        <button class="btn btn-outline-primary" type="submit">Reintentar</button>
    </form>
}
<partial name="Reparto/_BaseOperativa" model="Model" />
@if (Model.CargaCompleta || Model.MostrarPoliticaEnviada)
{
<form method="post" asp-page-handler="Politica" class="card card-body mb-4 nr-form-stack" data-single-submit>
    <h2 class="h4">Configuración de ruta · versión @Model.Politica.Version</h2>
    <input type="hidden" asp-for="Politica.Version" />
    <label asp-for="Politica.ZonaHoraria">Zona horaria IANA</label>
    <input asp-for="Politica.ZonaHoraria" class="form-control mb-2" required maxlength="100" placeholder="America/Montevideo" />
    <label asp-for="Politica.MaximoParadas">Máximo de paradas por ruta</label><input asp-for="Politica.MaximoParadas" class="form-control mb-2" min="1" max="500" required />
    <label class="mb-2"><input asp-for="Politica.RequiereFotoIntento" /> Exigir foto en intentos fallidos</label>
    <label class="mb-2"><input asp-for="Politica.BloquearDiscrepanciasCarga" /> Bloquear salida con diferencias de carga</label>
    <button class="btn btn-primary align-self-start">@(Model.CargaCompleta ? "Guardar nueva versión" : "Reintentar guardado")</button>
</form>
}
<p><a asp-page="/Vehiculos">Gestionar vehículos y capacidades</a></p>

<partial name="Reparto/_PerfilesViales" model="Model" />
