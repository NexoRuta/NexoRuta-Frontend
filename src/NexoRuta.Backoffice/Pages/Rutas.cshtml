@page "/rutas"
@model NexoRuta.Backoffice.Features.Reparto.Pages.RutasModel
@{ ViewData["Title"] = "Rutas y depósito"; }
<header class="nr-page-header"><div><h1>Rutas y depósito</h1><p>Consultá las paradas y gestioná el despacho y la rendición por fecha.</p></div></header>
@if (Model.Error is not null) { <div class="alert alert-danger" role="alert">@Model.Error</div> }
@if (Model.Confirmacion is not null) { <div class="alert alert-success" role="status">@Model.Confirmacion</div> }
<form method="get" class="nr-filter-form d-flex flex-wrap gap-2 align-items-end">
    <div><label asp-for="Fecha">Fecha de las rutas</label><input asp-for="Fecha" type="date" class="form-control" required /></div>
    <button class="btn btn-outline-primary">Consultar</button>
</form>
@if (!Model.CargaCompleta)
{
    <form method="get" asp-page-handler="Reintentar" class="mb-4">
        <input type="hidden" name="fecha" value="@(Model.Fecha.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))" />
        <button class="btn btn-outline-primary" type="submit">Reintentar</button>
    </form>
}
@if (Model.CargaCompleta && Model.Recursos is { } recursos)
{
    <p>Horas en @recursos.Politica.ZonaHoraria. Se carga una sola vez en depósito y se rinde al regresar.</p>
    <h2>Rutas del día</h2>
    @if (Model.Rutas.Count == 0) { <p>No hay rutas para esta fecha.</p> }
    @foreach (var ruta in Model.Rutas)
    {
        <section class="card card-body mb-3">
            <h3 class="h5">@Model.Repartidor(ruta.RepartidorAccesoId) · @ruta.Matricula · @ruta.Estado</h3>
            @if (ruta.IncidenciasCierre.Count > 0)
            {
                <div class="alert alert-warning" role="status">
                    <strong>Cierre con incidencia: bultos sin entrega ni rendición</strong>
                    <ul>@foreach (var incidencia in ruta.IncidenciasCierre)
                    {
                        <li>@incidencia.Codigo · registrado al cerrar la jornada. Custodia actual:
                            @(ruta.Paradas.SelectMany(p => p.Bultos).Single(b => b.Id == incidencia.BultoId).Custodia).</li>
                    }</ul>
                    <p class="mb-0">La incidencia se conserva como historial. Solo confirmar la recepción en depósito cuando los bultos estén físicamente presentes.</p>
                </div>
            }
            <div class="table-responsive" role="region" aria-label="Paradas en orden de recorrido; desplazamiento horizontal disponible en pantallas pequeñas" tabindex="0"><table class="table"><caption>Paradas en orden de recorrido</caption>
                <thead><tr><th>Orden</th><th>Hora</th><th>Destino</th><th>Bultos</th><th>Estado</th></tr></thead>
                <tbody>@foreach (var p in ruta.Paradas.OrderBy(p => p.Orden))
                {
                    <tr><td>@p.Orden</td><td>@Model.Hora(p.LlegadaEstimadaUtc, ruta.Politica.ZonaHoraria)</td><td>@p.Destinatario<br />@p.Direccion</td>
                        <td>@foreach (var b in p.Bultos) { <div>@b.Codigo · @b.Custodia</div> }</td>
                        <td>@p.Estado @if (!p.Activa) { <div>Fuera de esta ruta: @p.MotivoSuspension</div> }</td></tr>
                    @if (p.Estado == "NoEntregado")
                    {
                        <tr class="table-warning"><td colspan="5">
                            <strong>Requiere reprogramación a una ruta nueva.</strong>
                            <span>Intentos fallidos: @p.IntentosFallidos de @p.Reglas.MaximoIntentos.</span>
                            @if (p.ProximoIntentoElegibleUtc is { } elegible)
                            {
                                <span> Próxima tentativa elegible desde @Model.FechaHora(elegible, ruta.Politica.ZonaHoraria) (@ruta.Politica.ZonaHoraria).</span>
                            }
                            @if (p.IntentosFallidos >= p.Reglas.MaximoIntentos)
                            {
                                <p class="mb-0">No quedan intentos disponibles. No se puede reprogramar ni realizar otra tentativa.</p>
                                @if (Model.PuedeGestionarDecisionesOperativasEnvio && p.Reglas.PoliticaDevolucionAlAgotarIntentos == "DecisionOperativa")
                                {
                                    var motivoId = $"motivo-devolucion-{p.EnvioId}";
                                    var confirmarId = $"confirmar-devolucion-{p.EnvioId}";
                                    var comando = Model.DevolucionEnvioId == p.EnvioId && Model.ComandoId != Guid.Empty
                                        ? Model.ComandoId : Guid.NewGuid();
                                    <form method="post" asp-page-handler="IniciarDevolucion" data-single-submit class="mt-3">
                                        <input type="hidden" asp-for="Fecha" />
                                        <input type="hidden" name="DevolucionEnvioId" value="@p.EnvioId" />
                                        <input type="hidden" name="VersionEnvio" value="@p.EnvioVersion" />
                                        <input type="hidden" name="ComandoId" value="@comando" />
                                        <label for="@motivoId">Motivo para iniciar la devolución</label>
                                        <textarea id="@motivoId" name="MotivoDevolucion" class="form-control mb-2" maxlength="500" required>@(Model.DevolucionEnvioId == p.EnvioId ? Model.MotivoDevolucion : "")</textarea>
                                        <div class="form-check mb-3">
                                            <input id="@confirmarId" name="ConfirmarDevolucion" value="true" type="checkbox" class="form-check-input" required checked="@(Model.DevolucionEnvioId == p.EnvioId && Model.ConfirmarDevolucion ? "checked" : null)" />
                                            <label class="form-check-label" for="@confirmarId">Confirmo iniciar la devolución; esto no confirma que el bulto haya llegado al depósito.</label>
                                        </div>
                                        <button class="btn btn-primary" type="submit">Iniciar devolución</button>
                                    </form>
                                }
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Reprogramar" data-single-submit class="mt-2">
                                    <input type="hidden" asp-for="Fecha" />
                                    <input type="hidden" name="envioId" value="@p.EnvioId" />
                                    <input type="hidden" name="versionEnvio" value="@p.EnvioVersion" />
                                    <button class="btn btn-outline-primary" type="submit">Reprogramar para una ruta nueva</button>
                                </form>
                            }
                        </td></tr>
                    }
                }</tbody>
            </table></div>
            @if (ruta.Estado == "Planificada" && ruta.Paradas.Count > 0)
            {
                <form method="post" asp-page-handler="Despachar" data-single-submit>
                    <input type="hidden" asp-for="Fecha" /><input type="hidden" name="rutaId" value="@ruta.Id" /><input type="hidden" name="version" value="@ruta.Version" />
                    <button class="btn btn-primary">Despachar esta ruta</button>
                    <p class="mt-2 mb-0">Requiere todos los bultos recibidos físicamente en depósito y los destinos confirmados.</p>
                </form>
            }
        </section>
    }
    <details class="card card-body mb-4">
        <summary class="h4">Planificar una ruta</summary>
        <p>Elegí repartidor, vehículo y envíos. Definí el orden y la hora estimada de cada parada. El servidor valida capacidad, disponibilidad y destinos.</p>
        <form method="post" asp-page-handler="Planificar" data-single-submit>
            <input type="hidden" asp-for="Fecha" />
            <label asp-for="RepartidorAccesoId">Repartidor</label><select asp-for="RepartidorAccesoId" class="form-select mb-2" required><option value="">Seleccionar</option>
                @foreach (var r in recursos.Repartidores) { <option value="@r.AccesoId">@r.Nombre</option> }</select>
            <label asp-for="VehiculoId">Vehículo</label><select asp-for="VehiculoId" class="form-select mb-3" required><option value="">Seleccionar</option>
                @foreach (var v in recursos.Vehiculos) { <option value="@v.Id">@v.Matricula · @v.PesoMaximoGramos g · @v.VolumenMaximoCm3 cm³</option> }</select>
            <div class="table-responsive" role="region" aria-label="Envíos en depósito o reprogramados; desplazamiento horizontal disponible en pantallas pequeñas" tabindex="0"><table class="table"><caption>Envíos en depósito o reprogramados</caption><thead><tr><th>Incluir</th><th>Destino</th><th>Orden</th><th>Hora</th></tr></thead><tbody>
            @for (var i = 0; i < Model.Plan.Count; i++)
            {
                var envio = Model.Envios.Single(e => e.Id == Model.Plan[i].EnvioId);
                <tr><td><input type="hidden" asp-for="Plan[i].EnvioId" /><input asp-for="Plan[i].Incluir" aria-label="Incluir envío a @envio.DestinatarioNombre" /></td>
                    <td>@envio.DestinatarioNombre · @envio.Direccion<br />@string.Join(", ", envio.Bultos.Select(b => b.Codigo))</td>
                    <td><input asp-for="Plan[i].Orden" type="number" min="1" max="500" class="form-control" aria-label="Orden de @envio.DestinatarioNombre" /></td>
                    <td><input asp-for="Plan[i].Hora" type="time" class="form-control" aria-label="Hora de @envio.DestinatarioNombre" /></td></tr>
            }
            </tbody></table></div>
            <label class="d-block mb-3"><input asp-for="CrearBorrador" /> Crear borrador sin paradas para recibir una reasignación. No podrá despacharse vacío.</label>
            <button class="btn btn-primary">Guardar planificación</button>
        </form>
    </details>
    @if (Model.PuedeGestionarDecisionesOperativasEnvio)
    {
        <h2>Confirmar extravío</h2>
        <p>La confirmación cambia el estado comercial a Extraviado. No registra entrega, rendición, recepción ni transferencia física; la custodia conserva solo el último registro conocido.</p>
        @foreach (var envio in Model.Envios.Where(e => e.Id == Model.ExtravioEnvioId
            && e.Estado is not ("EnDeposito" or "AsignadoRuta" or "EnTransito" or "EnDevolucion")
            && !(e.Estado == "Extraviado" && Model.ComandoId != Guid.Empty)))
        {
            <div class="alert alert-warning" role="status">
                <h3 class="h6">Estado actualizado: @envio.Estado</h3>
                <p class="mb-1">No se puede confirmar el extravío desde este estado. No se enviará otra confirmación.</p>
                @if (!string.IsNullOrWhiteSpace(Model.MotivoExtravio))
                {
                    <p class="mb-0">Motivo conservado: @Model.MotivoExtravio</p>
                }
            </div>
        }
        @foreach (var envio in Model.Envios.Where(e => e.Estado is "EnDeposito" or "AsignadoRuta" or "EnTransito" or "EnDevolucion"
            || (e.Id == Model.ExtravioEnvioId && e.Estado == "Extraviado" && Model.ComandoId != Guid.Empty)))
        {
            var motivoId = $"motivo-extravio-{envio.Id}";
            var confirmarId = $"confirmar-extravio-{envio.Id}";
            var comando = Model.ExtravioEnvioId == envio.Id && Model.ComandoId != Guid.Empty
                ? Model.ComandoId : Guid.NewGuid();
            var version = Model.ExtravioEnvioId == envio.Id && Model.ComandoId != Guid.Empty
                ? Model.VersionEnvio : envio.Version;
            <form method="post" asp-page-handler="ConfirmarExtravio" data-single-submit class="card card-body mb-2">
                <input type="hidden" asp-for="Fecha" />
                <input type="hidden" name="ExtravioEnvioId" value="@envio.Id" />
                <input type="hidden" name="VersionEnvio" value="@version" />
                <input type="hidden" name="ComandoId" value="@comando" />
                <h3 class="h6">@envio.DestinatarioNombre · @envio.Estado</h3>
                <p class="mb-2">@envio.Direccion · @string.Join(", ", envio.Bultos.Select(b => b.Codigo))</p>
                @if (envio.Estado == "Extraviado")
                {
                    <p class="text-warning-emphasis">La solicitud pudo haberse confirmado antes de perderse la respuesta. Reintentá con el mismo comando para recuperar el resultado; no se creará otra confirmación.</p>
                }
                <label for="@motivoId">Motivo de extravío</label>
                <textarea id="@motivoId" name="MotivoExtravio" class="form-control mb-2" maxlength="500" required>@(Model.ExtravioEnvioId == envio.Id ? Model.MotivoExtravio : "")</textarea>
                <div class="form-check mb-3">
                    <input id="@confirmarId" name="ConfirmarExtravio" value="true" type="checkbox" class="form-check-input" required checked="@(Model.ExtravioEnvioId == envio.Id && Model.ConfirmarExtravio ? "checked" : null)" />
                    <label class="form-check-label" for="@confirmarId">Confirmo que el envío pasará a Extraviado; esto no acredita dónde está físicamente el bulto.</label>
                </div>
                <button class="btn btn-outline-danger align-self-start" type="submit">@(envio.Estado == "Extraviado" ? "Reintentar la misma confirmación" : "Confirmar extravío")</button>
            </form>
        }
    }
    <h2>Recepción en depósito</h2>
    <p>Confirmá únicamente cuando hayas recibido todos los bultos del envío. Requiere rendición declarada o una incidencia registrada al cerrar la jornada; recibir nunca elimina esa incidencia.</p>
    @foreach (var envio in Model.Envios.Where(e => e.Estado is "Admitido" or "Reprogramado" or "Cancelado" or "AsignadoRuta" or "EnDevolucion"
        || Model.Rutas.Any(r => r.IncidenciasCierre.Any(i => i.EnvioId == e.Id)) && e.Estado is ("EnTransito" or "NoEntregado")))
    {
        <form method="post" asp-page-handler="Recibir" class="card card-body mb-2" data-single-submit>
            <input type="hidden" asp-for="Fecha" /><input type="hidden" name="envioId" value="@envio.Id" /><input type="hidden" name="version" value="@envio.Version" />
            <p>@envio.DestinatarioNombre · @envio.Estado · @string.Join(", ", envio.Bultos.Select(b => b.Codigo))</p>
            <button class="btn btn-outline-primary align-self-start">Confirmar recepción de todos los bultos</button>
        </form>
    }
    <h2 class="mt-4">Postergar una entrega</h2>
    <p>Seleccioná arriba la fecha futura y planificá su ruta destino. El bulto vuelve con su repartidor actual y requiere recepción antes del nuevo despacho.</p>
    @if (!Model.Rutas.Any(r => r.Estado == "Planificada")) { <p>No hay rutas planificadas en esta fecha para recibir una reasignación.</p> }
    else
    {
        @foreach (var envio in Model.Envios.Where(e => e.Estado is "AsignadoRuta" or "EnTransito"))
        {
            <details class="card card-body mb-2"><summary>@envio.DestinatarioNombre · @envio.Direccion · @envio.Estado</summary>
            <form method="post" asp-page-handler="Reasignar" class="mt-3" data-single-submit>
                <input type="hidden" asp-for="Fecha" /><input type="hidden" name="envioId" value="@envio.Id" /><input type="hidden" name="versionEnvio" value="@envio.Version" />
                <label for="destino-@envio.Id">Ruta destino</label><select id="destino-@envio.Id" name="destino" class="form-select mb-2" required><option value="">Seleccionar</option>
                    @foreach (var r in Model.Rutas.Where(r => r.Estado == "Planificada" && r.Paradas.All(p => p.EnvioId != envio.Id)))
                    { <option value="@r.Id:@r.Version">@Model.Repartidor(r.RepartidorAccesoId) · @r.Matricula · @r.Paradas.Count parada(s)</option> }</select>
                <label for="hora-@envio.Id">Hora de llegada (al final de esa ruta)</label><input id="hora-@envio.Id" type="time" name="hora" class="form-control mb-2" required />
                <label for="motivo-@envio.Id">Motivo</label><textarea id="motivo-@envio.Id" name="motivo" class="form-control mb-3" required maxlength="500"></textarea>
                <button class="btn btn-outline-primary">Postergar a esa ruta</button>
            </form></details>
        }
    }
}
