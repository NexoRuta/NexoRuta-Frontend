@page "/Error"
@using System.Diagnostics

<PageTitle>Error | NexoRuta</PageTitle>

<section class="nr-page nr-page-tracking">
    <header class="nr-page-heading">
        <div>
            <p class="nr-eyebrow">NO SE PUDO COMPLETAR</p>
            <h1>No pudimos cargar esta página</h1>
            <p>Intentá recargarla. Si el problema continúa, compartí el identificador con soporte.</p>
        </div>
    </header>

@if (ShowRequestId)
{
    <p>
        <strong>Identificador de consulta:</strong> <code>@RequestId</code>
    </p>
}
    <a class="btn btn-primary" href="/">Ir al inicio</a>
</section>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
