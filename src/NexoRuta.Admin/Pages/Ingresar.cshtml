@page "/ingresar"
@model NexoRuta.Admin.Features.Sesion.Pages.IngresarModel
@{ ViewData["Title"] = "Sign in"; }
<section class="card mx-auto login-card"><div class="card-body p-4">
    <p class="text-muted">NexoRuta · Platform</p><h1 class="h3">Sign in</h1>
    <p>Only platform administrators can use this portal.</p>
    @if (Model.Error is not null) { <p class="alert alert-danger" role="alert">@Model.Error</p> }
    <form method="post" asp-page="/Ingresar" data-single-submit>
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control mb-3" type="email" autocomplete="username" required maxlength="254" />
        <label for="Password" class="form-label">Password</label>
        <input name="Password" id="Password" type="password" class="form-control mb-3" autocomplete="current-password" required />
        <button type="submit" class="btn btn-primary w-100">Sign in</button>
    </form>
    <p><a href="/recuperar-contrasena">¿Olvidaste tu contraseña?</a></p>
</div></section>
