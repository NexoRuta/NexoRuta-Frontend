@page "/solicitudes-reactivacion/{id:guid}"
@model NexoRuta.Admin.Features.Organizaciones.Pages.SolicitudReactivacionDetalleModel
@{ ViewData["Title"] = "Solicitud de reactivación"; }
<a href="/solicitudes-reactivacion">Volver a solicitudes</a>
@if (Model.Confirmacion is not null) { <p class="alert alert-success mt-3" role="status">@Model.Confirmacion</p> }
@if (Model.Error is not null) { <p class="alert alert-danger mt-3" role="alert">@Model.Error</p> }
@if (Model.Solicitud is { } request)
{
    <h1 class="mt-3">@request.NombreOrganizacion</h1>
    <dl class="card p-4"><dt>Tipo de organización</dt><dd>@request.TipoOrganizacion</dd><dt>Estado</dt><dd>@request.Estado</dd>
        <dt>Solicitada</dt><dd>@request.SolicitadaEnUtc.ToLocalTime()</dd><dt>Solicitada por</dt><dd class="text-break">@request.SolicitadaPorUsuarioId</dd>
        <dt>Motivo</dt><dd class="text-break">@request.Motivo</dd>
        @if (request.ResueltaEnUtc is not null) { <dt>Resuelta</dt><dd>@request.ResueltaEnUtc.Value.ToLocalTime()</dd><dt>Motivo de resolución</dt><dd>@request.MotivoResolucion</dd> }
    </dl>
    @if (request.Estado == "Pendiente")
    {
        <form method="post" data-single-submit class="card p-4 mt-4">
            <input type="hidden" asp-for="Version" />
            <p>Aprobar reactiva la organización; sus usuarios deberán ingresar nuevamente. Rechazar mantiene la suspensión. No se elimina ningún dato.</p>
            <label asp-for="Motivo" class="form-label">Motivo de resolución</label><textarea asp-for="Motivo" class="form-control" maxlength="2000" required></textarea>
            <span asp-validation-for="Motivo" class="text-danger"></span>
            <div class="form-check mt-3"><input class="form-check-input" type="checkbox" asp-for="Confirmar" required /><label class="form-check-label" asp-for="Confirmar">Entiendo el efecto de esta decisión.</label></div>
            <span asp-validation-for="Confirmar" class="text-danger"></span>
            <span asp-validation-for="Decision" class="text-danger"></span>
            <span asp-validation-for="Version" class="text-danger"></span>
            <div class="d-flex gap-2 mt-3"><button class="btn btn-success" type="submit" asp-page-handler="Resolver" name="decision" value="Aprobar">Aprobar y reactivar</button>
                <button class="btn btn-outline-secondary" type="submit" asp-page-handler="Resolver" name="decision" value="Rechazar">Rechazar solicitud</button></div>
        </form>
    }
}
