@page "/"
@model NexoRuta.Admin.Features.DatosDemo.Pages.IndexModel
@{ ViewData["Title"] = "Administración de plataforma"; }
<p class="text-uppercase text-muted small">Administración de plataforma</p>
<h1>Organizaciones</h1>
<p class="lead">Gestioná operadores, comercios y sus administradores.</p>
<div class="row g-4 mt-2">
    <section class="col-md-6"><div class="card h-100"><div class="card-body p-4">
        <h2 class="h4">Operadores</h2><p>Organizaciones que prestan servicios logísticos.</p>
        <a class="btn btn-primary" href="/operadores">Ver operadores</a>
    </div></div></section>
    <section class="col-md-6"><div class="card h-100"><div class="card-body p-4">
        <h2 class="h4">Comercios</h2><p>Comercios que eligen un operador para cada envío.</p>
        <a class="btn btn-primary" href="/comercios">Ver comercios</a>
    </div></div></section>
</div>

<details class="nr-disclosure mt-4" open="@(Model.Error is not null || Model.Confirmacion is not null)"><summary>Datos sintéticos de demostración</summary><section class="mt-5" aria-labelledby="demo-data-title">
    <h2 id="demo-data-title">Datos de demostración</h2>
    <p>Cargá cinco operadores y cinco comercios sintéticos, con sus cuentas y una semana de actividad. Esta operación se ejecuta una sola vez.</p>
    @if (Model.Error is not null)
    {
        <p class="alert alert-danger" role="alert">@Model.Error</p>
    }
    @if (Model.Confirmacion is not null)
    {
        <p class="alert alert-success" role="status">@Model.Confirmacion</p>
    }
    @if (Model.Estado is { Sembrada: true } estado)
    {
        <div class="border rounded p-3" role="status">
            <p class="mb-2"><strong>Datos de demostración cargados</strong> · @Model.FechaLocal(estado.SembradoEnUtc!.Value)</p>
            <dl class="row mb-0">
                <dt class="col-sm-6">Operadores / comercios</dt><dd class="col-sm-6">@estado.Operadores / @estado.Comercios</dd>
                <dt class="col-sm-6">Cuentas de operadores / comercios</dt><dd class="col-sm-6">@estado.CuentasOperador / @estado.CuentasComercio</dd>
                <dt class="col-sm-6">Envíos / rutas</dt><dd class="col-sm-6">@estado.Envios / @estado.Rutas</dd>
                <dt class="col-sm-6">Operaciones de entrega</dt><dd class="col-sm-6">@estado.Operaciones</dd>
            </dl>
        </div>
    }
    else if (Model.Estado is { Sembrada: false })
    {
        <p role="status">Todavía no se cargaron datos de demostración.</p>
        <form method="post" asp-page-handler="Sembrar" data-single-submit class="mt-3">
            <button type="submit" class="btn btn-primary" data-loading-text="Cargando datos de demostración…">Cargar datos de demostración</button>
        </form>
    }
</section>
</details>
