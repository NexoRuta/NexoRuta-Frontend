@page "/{tipo:regex(^(operadores|comercios)$)}/crear"
@model NexoRuta.Admin.Features.Organizaciones.Pages.CrearModel
@{ ViewData["Title"] = $"Create {Model.Titulo}"; }
<a href="/@Model.Tipo">Volver al listado</a>
<h1 class="my-3">Crear @Model.Titulo</h1>
<p>La organización y su primer administrador se crean juntos. Tu sesión de administración se conserva.</p>
@if (Model.Error is not null) { <p class="alert alert-danger" role="alert">@Model.Error</p> }
<form method="post" data-single-submit class="card form-card"><div class="card-body p-4">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <label asp-for="Nombre" class="form-label">Nombre de la organización</label>
    <input asp-for="Nombre" class="form-control mb-4" maxlength="160" required autocomplete="organization" />
    <fieldset><legend class="h5">Primer administrador</legend>
        <label asp-for="Email" class="form-label">Correo del administrador</label>
        <input asp-for="Email" type="email" class="form-control mb-3" maxlength="254" required autocomplete="off" />
        <label for="Password" class="form-label">Contraseña</label>
        <input id="Password" name="Password" type="password" class="form-control mb-3" required minlength="12" autocomplete="new-password" aria-describedby="password-help" />
        <p id="password-help" class="form-text">Usá al menos 12 caracteres y una contraseña exclusiva para esta cuenta.</p>
        <label for="ConfirmPassword" class="form-label">Confirmar contraseña</label>
        <input id="ConfirmPassword" name="ConfirmPassword" type="password" class="form-control mb-4" required minlength="12" autocomplete="new-password" />
    </fieldset>
    <button type="submit" class="btn btn-primary">Crear organización</button>
    <a href="/@Model.Tipo" class="btn btn-link">Cancelar</a>
</div></form>
