@page "/{tipo:regex(^(operadores|comercios)$)}"
@model NexoRuta.Admin.Features.Organizaciones.Pages.ListarModel
@{ ViewData["Title"] = Model.Titulo; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1>@Model.Titulo</h1><a class="btn btn-primary" href="/@Model.Tipo/crear">Crear organización</a>
</div>
<form method="get" class="d-flex flex-wrap gap-2 align-items-end mb-3">
    <div><label for="state-filter" class="form-label">Estado</label>
        <select id="state-filter" name="Estado" class="form-select">
            <option value="">Todos</option>
            <option value="Activa" selected="@(Model.Estado == "Activa")">Activa</option>
            <option value="Suspendida" selected="@(Model.Estado == "Suspendida")">Suspendida</option>
        </select></div>
    <button class="btn btn-outline-primary" type="submit">Filtrar</button>
</form>
@if (Model.Error is not null) { <p class="alert alert-danger" role="alert">@Model.Error</p> }
@if (Model.Resultado is { } result)
{
    <p class="text-muted">@result.Total organizaciones · Página @result.Pagina</p>
    @if (result.Items.Count == 0) { <p class="alert alert-info">No hay organizaciones para estos filtros.</p> }
    else
    {
        <div class="table-responsive bg-white rounded border"><table class="table mb-0">
            <caption class="visually-hidden">@Model.Titulo, ordenados por nombre e identificador</caption>
            <thead><tr><th scope="col">Nombre</th><th scope="col">Estado</th><th scope="col">Detalle</th></tr></thead>
            <tbody>@foreach (var organization in result.Items)
            {
                <tr><th scope="row">@organization.Nombre<details class="nr-disclosure"><summary>Identificador</summary><code>@organization.Id</code></details></th><td>@organization.Estado</td>
                    <td><a href="/@Model.Tipo/@organization.Id" aria-label="Ver @organization.Nombre">Ver</a></td></tr>
            }</tbody>
        </table></div>
    }
    <nav class="d-flex gap-3 align-items-center mt-4" aria-label="Pagination">
        @if (Model.Pagina > 1) { <a href="/@Model.Tipo?pagina=@(Model.Pagina - 1)&amp;tamanoPagina=@Model.TamanoPagina&amp;Estado=@Model.Estado">Anterior</a> }
        @if ((long)Model.Pagina * Model.TamanoPagina < result.Total) { <a href="/@Model.Tipo?pagina=@(Model.Pagina + 1)&amp;tamanoPagina=@Model.TamanoPagina&amp;Estado=@Model.Estado">Siguiente</a> }
    </nav>
}
