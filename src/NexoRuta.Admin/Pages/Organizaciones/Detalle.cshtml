@page "/{tipo:regex(^(operadores|comercios)$)}/{id:guid}"
@model NexoRuta.Admin.Features.Organizaciones.Pages.DetalleModel
@{ ViewData["Title"] = Model.Titulo; }
<a href="/@Model.Tipo">Volver al listado</a>
@if (Model.Organizacion is { } organization)
{
    @if (Model.Confirmacion is not null) { <p class="alert alert-success mt-3" role="status">@Model.Confirmacion</p> }
    <h1 class="mt-3">@organization.Nombre</h1>
    <p class="text-muted">Datos de @Model.Titulo</p>
    @if (Model.Confirmacion is not null) { <p class="alert alert-success" role="status">@Model.Confirmacion</p> }
    @if (Model.Error is not null) { <p class="alert alert-danger" role="alert">@Model.Error</p> }
    <dl class="card p-4"><dt>Identificador</dt><dd class="text-break">@organization.Id</dd><dt>Nombre</dt><dd>@organization.Nombre</dd><dt>Estado</dt><dd>@organization.Estado</dd></dl>
    <form method="post" asp-page-handler="CambiarEstado" data-single-submit class="card p-4 mt-4">
        <input type="hidden" name="estado" value="@(organization.Estado == "Activa" ? "Suspendida" : "Activa")" />
        <input type="hidden" asp-for="Version" />
        <p>@(organization.Estado == "Activa"
            ? "La suspensión bloquea nuevas operaciones y revoca las sesiones de la organización. Se conservan los envíos y su historial."
            : "La reactivación permite iniciar nuevas sesiones. Las sesiones revocadas y los accesos deshabilitados individualmente no se restauran.")</p>
        <label asp-for="Motivo" class="form-label">Motivo</label>
        <textarea asp-for="Motivo" class="form-control" maxlength="2000" required></textarea>
        <span asp-validation-for="Motivo" class="text-danger"></span>
        <div class="form-check mt-3"><input class="form-check-input" type="checkbox" id="Confirmar" name="Confirmar" value="true" required />
            <label class="form-check-label" for="Confirmar">Entiendo el efecto de esta acción.</label></div>
        <button type="submit" class="btn btn-warning mt-3">@(organization.Estado == "Activa" ? "Suspender organización" : "Reactivar organización")</button>
    </form>
}
else { <h1 class="mt-3">Organización no disponible</h1><p>No encontramos esta organización o ya no está disponible.</p> }
