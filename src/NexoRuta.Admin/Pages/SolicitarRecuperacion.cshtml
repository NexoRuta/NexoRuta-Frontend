@page "/recuperar-contrasena"
@model NexoRuta.Admin.Features.Sesion.Pages.SolicitarRecuperacionModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{ ViewData["Title"] = "Recuperar contraseña"; Layout = "_AuthLayout"; }
<section class="nr-auth-panel" aria-labelledby="recovery-heading">
    <h1 id="recovery-heading">Recuperar contraseña</h1>
    <p>Te enviaremos un enlace si hay una cuenta asociada.</p>
    @if (Model.SolicitudEnviada) { <p class="nr-auth-message" role="status">Si hay una cuenta asociada, recibirás un enlace para cambiar la contraseña.</p> }
    @if (Model.Error is not null) { <p class="nr-auth-message" role="alert">@Model.Error</p> }
    <form method="post" asp-page="/SolicitarRecuperacion" data-single-submit>
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="nr-auth-field">
            <label asp-for="Email" class="form-label">Correo electrónico</label>
            <input asp-for="Email" class="form-control" type="email" autocomplete="email" required maxlength="254" aria-describedby="Email-validation" />
            <span asp-validation-for="Email" id="Email-validation" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary nr-auth-submit">Enviar enlace</button>
    </form>
    <p class="nr-auth-secondary"><a href="/ingresar">Volver al ingreso</a></p>
</section>
