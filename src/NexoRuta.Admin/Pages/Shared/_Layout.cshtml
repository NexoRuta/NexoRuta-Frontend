<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | NexoRuta, administración</title>
    <link rel="stylesheet" href="~/lib/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/portal-design.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{ var mostrarNavegacion = User.Identity?.IsAuthenticated == true && Context.Items.ContainsKey(NexoRuta.Admin.Core.Security.ApiPermissionAuthorizationHandler.PermissionsCacheKey); }
<body class="nr-admin-shell">
    <a class="nr-skip-link" href="#main-content">Saltar al contenido principal</a>
    <div class="nr-app-shell">
        <header class="nr-topbar">
            <a class="nr-brand" href="/" aria-label="NexoRuta, administración de plataforma"><span class="nr-brand-mark" aria-hidden="true">N</span><span>NexoRuta <small>Administración</small></span></a>
            <div class="nr-topbar-actions">
                @if (User.Identity?.IsAuthenticated == true) { <form method="post" asp-page="/Salir" data-single-submit><button class="btn btn-outline-secondary" type="submit">Cerrar sesión</button></form> }
                @if (mostrarNavegacion) { <button type="button" class="nr-menu-toggle btn btn-outline-secondary d-lg-none" data-portal-nav-toggle aria-controls="adminNavigation" aria-expanded="false" aria-label="Mostrar u ocultar navegación principal">Menú</button> }
            </div>
        </header>
        <div class="nr-portal-layout @(mostrarNavegacion ? "has-sidebar" : null)">
            @if (mostrarNavegacion)
            {
                <aside id="adminNavigation" class="nr-sidebar"><nav class="nr-navigation" aria-label="Navegación principal"><div class="nr-nav-group"><p class="nr-nav-heading">Plataforma</p><ul class="nr-nav-list">
                @foreach (var link in new[] { (Path: "/", Label: "Inicio"), (Path: "/operadores", Label: "Operadores"), (Path: "/comercios", Label: "Comercios"), (Path: "/solicitudes-baja", Label: "Solicitudes de baja"), (Path: "/solicitudes-reactivacion", Label: "Solicitudes de reactivación") })
                {
                    var activo = link.Path == "/" ? Context.Request.Path == "/" : Context.Request.Path.StartsWithSegments(link.Path);
                    <li><a class="nr-nav-link" href="@link.Path" aria-current="@(activo ? "page" : null)">@link.Label</a></li>
                }
                </ul></div></nav></aside>
            }
            <div class="nr-main-column"><main id="main-content" class="nr-main-content" tabindex="-1"><div class="nr-page">@RenderBody()</div></main><footer class="nr-footer">NexoRuta · Administración de plataforma</footer></div>
        </div>
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/portal-interactions.js" asp-append-version="true"></script>
</body>
</html>
